<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The driver's tests: the conformance check every driver passes
    (docs/plc-drivers.md section 6), and tests of its own. Here Sirius.Plc
    is copied (Private=true): a test runs the driver without the program.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <SiriusLib Condition="'$(SiriusLib)' == ''">$(MSBuildThisFileDirectory)..\lib\</SiriusLib>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SampleDriver\SampleDriver.csproj" />
    <Reference Include="Sirius.Plc" HintPath="$(SiriusLib)Sirius.Plc.dll" />
    <Reference Include="Sirius.Core" HintPath="$(SiriusLib)Sirius.Core.dll" />
    <Reference Include="CommunityToolkit.Mvvm" HintPath="$(SiriusLib)CommunityToolkit.Mvvm.dll" />
  </ItemGroup>

</Project>
