<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the sample library, written the way a team would test its
    own: TestRun from Sirius.Plugins, and nothing from the application.

    tools/pack-sdk.ps1 ships these with a project file that references the
    Sirius.Plugins package instead of the projects below.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sirius.Samples.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SampleNodes\SampleNodes.csproj" />

    <!--
      Unlike the library, its tests run without the application, so they
      need Sirius.Plugins - and the Sirius.Core it carries - at run time.
    -->
    <ProjectReference Include="..\..\src\Sirius.Plugins\Sirius.Plugins.csproj" />
    <ProjectReference Include="..\..\src\Sirius.Core\Sirius.Core.csproj" />
  </ItemGroup>

</Project>
