<Window x:Class="Sirius.Tools.LicenceMakerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sirius Licence Maker"
        Width="620"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="#555" />
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Problem" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C62828" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <TabControl Margin="10">
        <!-- A code for a PC. -->
        <TabItem Header="Make a Code">
            <StackPanel Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Program" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding ProductNames}" SelectedIndex="{Binding ProductIndex}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Machine ID - as the program shows it" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="This PC" MinWidth="72" Margin="8,0,0,0" Command="{Binding ThisPcCommand}"
                                    ToolTip="This PC's machine ID, for a code for this PC" />
                            <TextBox x:Name="MachineBox"
                                     Text="{Binding MachineText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding MachineProblem}" Style="{StaticResource Problem}" Margin="162,4,0,0" />

                <TextBlock Text="For - a name, shown with the licence (optional)" Style="{StaticResource Label}" Margin="0,10,0,4" />
                <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ToProblem}" Style="{StaticResource Problem}" />

                <TextBlock Text="How long" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton GroupName="Length" IsChecked="{Binding IsDays}" VerticalAlignment="Center" Content="A trial of" />
                    <TextBox Text="{Binding DaysText, UpdateSourceTrigger=PropertyChanged}"
                             Width="48"
                             Margin="8,0"
                             HorizontalContentAlignment="Right"
                             IsEnabled="{Binding IsDays}" />
                    <TextBlock Text="days, today the first" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton GroupName="Length" IsChecked="{Binding IsUntil}" VerticalAlignment="Center" Content="A trial to" />
                    <DatePicker SelectedDate="{Binding Until}" Margin="8,0" Width="140" IsEnabled="{Binding IsUntil}" />
                </StackPanel>
                <RadioButton GroupName="Length" IsChecked="{Binding IsNoEnd}" Content="No end - a full licence" Margin="0,0,0,6" />
                <TextBlock Text="{Binding LastDayText}" Style="{StaticResource Note}" Margin="20,0,0,0" />

                <Button Content="Make Code" HorizontalAlignment="Left" MinWidth="110" Padding="0,4" Margin="0,14,0,0"
                        IsDefault="True" Command="{Binding MakeCommand}" />

                <TextBlock Text="Code" Style="{StaticResource Label}" Margin="0,14,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy" MinWidth="72" Margin="8,0,0,0" VerticalAlignment="Top" Command="{Binding CopyCommand}" />
                    <TextBox Text="{Binding Code, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             Height="64"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </DockPanel>
                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Problem}" Style="{StaticResource Problem}" Margin="0,4,0,0" />

                <Separator Margin="0,14,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Key File…" MinWidth="80" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnChooseKey" />
                    <StackPanel>
                        <TextBlock Text="{Binding KeyText, StringFormat='Signing key: {0}'}" Style="{StaticResource Note}" />
                        <TextBlock Text="{Binding LogText}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </TabItem>

        <!-- A code sent in, read back. -->
        <TabItem Header="Read a Code">
            <StackPanel Margin="12">
                <TextBlock Text="A code, pasted - to see what it is for and how long it runs" Style="{StaticResource Label}" />
                <TextBox Text="{Binding CodeToRead, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="{Binding ReadText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
