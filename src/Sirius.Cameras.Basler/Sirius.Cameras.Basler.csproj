<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Basler cameras, through pylon's .NET API.

    Built against the API pylon installs (PYLON_DEV_DIR points at it). On a
    PC without pylon there is nothing to build against, so the project
    compiles to an empty library and the application simply lists no Basler
    cameras - the solution still builds anywhere.

    At run time the pylon runtime must be installed: the .NET API is copied
    beside the application, but it calls into pylon's native libraries,
    which the runtime installer puts on the path.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sirius.Cameras.Basler</RootNamespace>
    <PylonApi>$(PYLON_DEV_DIR)Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</PylonApi>

    <!--
      The pylon release PYLON_DEV_DIR is from, as Basler names it. Only for
      what a PC with too old a pylon is told to install - the check itself
      compares the .NET API's own version. Change it with pylon.
    -->
    <PylonRelease>26.10</PylonRelease>
    <HasPylon Condition="'$(PYLON_DEV_DIR)' != '' And Exists('$(PylonApi)')">true</HasPylon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HasPylon)' != 'true'">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sirius.Vision\Sirius.Vision.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasPylon)' == 'true'">
    <Reference Include="Basler.Pylon">
      <HintPath>$(PylonApi)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PylonRelease</_Parameter1>
      <_Parameter2>$(PylonRelease)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Sirius.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
