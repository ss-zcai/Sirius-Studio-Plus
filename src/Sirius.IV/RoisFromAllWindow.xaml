<Window x:Class="Sirius.IV.RoisFromAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROIs from All Pictures"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        Which rectangles to cut: each picture's own - where they were drawn -
        or the ones on the picture shown, cut from every picture listed.
    -->
    <StackPanel Margin="16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <TextBlock Text="Cut" FontWeight="SemiBold" Margin="0,0,0,6" />

        <RadioButton x:Name="OwnOption" GroupName="Which" Margin="0,2">
            <TextBlock x:Name="OwnText" TextWrapping="Wrap" />
        </RadioButton>
        <TextBlock Margin="20,0,0,6"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Drawn and saved, or drawn and not saved yet. Pictures without any are passed over." />

        <RadioButton x:Name="SameOption" GroupName="Which" Margin="0,6,0,2">
            <TextBlock x:Name="SameText" TextWrapping="Wrap" />
        </RadioButton>
        <TextBlock Margin="20,0,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="The same places on every picture - for a set of training images." />

        <TextBlock Margin="0,12,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Each crop is saved as picture-1.png, picture-2.png… in the folder you choose next, upright and in the picture's own bits." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cut…" MinWidth="88" IsDefault="True" Click="OnCut" />
            <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
