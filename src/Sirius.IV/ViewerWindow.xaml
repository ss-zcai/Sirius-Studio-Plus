<Window x:Class="Sirius.IV.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirius.IV"
        xmlns:controls="clr-namespace:Sirius.Studio.App.Controls;assembly=SiriusStudioPlus"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        Title="{Binding Title}"
        Width="1500"
        Height="900"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Background}"
        AllowDrop="True"
        Drop="OnDrop"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <!--
        Sirius IV: the pictures of a folder in a panel on the left, and one
        or several viewers in the middle showing the ones chosen, each with
        the shapes from its annotation file drawn over it. Other panels -
        the annotations as a table - come later, docked beside these.
    -->
    <Window.Resources>
        <Style x:Key="ToolbarTextButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="34" />
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- PASS green, FAIL and ERROR red, as a screen's verdict. -->
        <Style x:Key="VerdictBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#3A3D42" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="PASS">
                    <Setter Property="Background" Value="#2E7D4F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="FAIL">
                    <Setter Property="Background" Value="#A33A3A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="ERROR">
                    <Setter Property="Background" Value="#A36A1F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A file's type on its icon: each kind a colour of its own. -->
        <Style x:Key="FileKindBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="2,0,2,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Background" Value="#5A606B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="PNG">
                    <Setter Property="Background" Value="#2F74B5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="JPG">
                    <Setter Property="Background" Value="#B7791F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="BMP">
                    <Setter Property="Background" Value="#7A52B3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="TIF">
                    <Setter Property="Background" Value="#23897A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="FileMenu">
            <MenuItem Header="Copy _Name" InputGestureText="Ctrl+C" Command="{x:Static local:ViewerWindow.CopyNameCommand}" />
            <MenuItem Header="Copy Full _Path" InputGestureText="Ctrl+Shift+C" Command="{x:Static local:ViewerWindow.CopyPathCommand}" />
            <Separator />
            <MenuItem Header="Show in _Explorer" Command="{x:Static local:ViewerWindow.ShowInExplorerCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:ViewerWindow.OpenFolderCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:ViewerWindow.SearchCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Single}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Two}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Four}" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Nine}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:ViewerWindow.OpenFolderCommand}" Executed="OnOpenFolder" />
        <CommandBinding Command="{x:Static local:ViewerWindow.SearchCommand}" Executed="OnSearch" />
        <CommandBinding Command="{x:Static local:ViewerWindow.CopyNameCommand}" Executed="OnCopyName" CanExecute="OnCanUseChosen" />
        <CommandBinding Command="{x:Static local:ViewerWindow.CopyPathCommand}" Executed="OnCopyPath" CanExecute="OnCanUseChosen" />
        <CommandBinding Command="{x:Static local:ViewerWindow.ShowInExplorerCommand}" Executed="OnShowInExplorer" CanExecute="OnCanUseChosen" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Folder…" InputGestureText="Ctrl+O" Command="{x:Static local:ViewerWindow.OpenFolderCommand}" />
                <MenuItem Header="_Refresh" InputGestureText="F5" Command="{Binding RefreshCommand}" />
                <MenuItem Header="_Save Measurements" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <Separator />
                <MenuItem Header="Copy _Name" InputGestureText="Ctrl+C" Command="{x:Static local:ViewerWindow.CopyNameCommand}" />
                <MenuItem Header="Copy Full _Path" InputGestureText="Ctrl+Shift+C" Command="{x:Static local:ViewerWindow.CopyPathCommand}" />
                <MenuItem Header="Show in _Explorer" Command="{x:Static local:ViewerWindow.ShowInExplorerCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_One Picture" InputGestureText="Ctrl+1" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Single}" />
                <MenuItem Header="_Two Side by Side" InputGestureText="Ctrl+2" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Two}" />
                <MenuItem Header="2 × 2" InputGestureText="Ctrl+4" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Four}" />
                <MenuItem Header="3 × 3" InputGestureText="Ctrl+9" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static local:ViewerLayout.Nine}" />
                <Separator />
                <MenuItem Header="Include _Sub-folders" IsCheckable="True" IsChecked="{Binding IncludeSubfolders}" />
                <Separator />
                <MenuItem Header="_Files" Click="OnShowFiles" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Sirius IV…" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,1"
                Padding="6,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CountText}"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0"
                           Foreground="{StaticResource Text.Secondary}" />

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarTextButton}" ToolTip="Open a folder of pictures (Ctrl+O)" Command="{x:Static local:ViewerWindow.OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.ph_open}" Width="18" Height="18" />
                            <TextBlock Text="Open Folder" Style="{StaticResource ToolbarLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarTextButton}" ToolTip="Save the measurements drawn on the pictures, each in its annotation file (Ctrl+S)" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.ph_save}" Width="18" Height="18" />
                            <TextBlock Text="Save" Style="{StaticResource ToolbarLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarTextButton}" ToolTip="Read the folder again, for pictures saved since (F5)" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.ph_redo}" Width="18" Height="18" />
                            <TextBlock Text="Refresh" Style="{StaticResource ToolbarLabel}" />
                        </StackPanel>
                    </Button>

                    <Separator />

                    <TextBlock Text="Show" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="{StaticResource Text.Secondary}" />
                    <ComboBox ItemsSource="{x:Static local:BrowserViewModel.Filters}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Filter}"
                              MinWidth="90"
                              ToolTip="Every picture, or only those a station saved as failed - or passed" />

                    <TextBlock Text="Viewers" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{StaticResource Text.Secondary}" />
                    <ComboBox ItemsSource="{x:Static local:BrowserViewModel.Layouts}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Layout}"
                              MinWidth="130"
                              ToolTip="How many pictures at once (Ctrl+1, 2, 4, 9). Choose several in the list to see those; choose one to see it and those after it." />
                </StackPanel>
            </DockPanel>
        </Border>

        <avalonDock:DockingManager x:Name="Docking"
                                   Grid.Row="2"
                                   AllowMixedOrientation="True"
                                   Background="{StaticResource Surface.Background}">
            <avalonDock:DockingManager.Theme>
                <themes:Vs2013DarkTheme />
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <!-- The pictures in the folder -->
                    <avalonDock:LayoutAnchorablePane DockWidth="300">
                        <avalonDock:LayoutAnchorable x:Name="FilesPanel" Title="Files" ContentId="files" CanClose="False">
                            <DockPanel Margin="6">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{Binding Folder}"
                                           ToolTip="{Binding Folder}"
                                           FontSize="11"
                                           Margin="0,0,0,6"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Text.Secondary}" />

                                <!-- Search the names: as Studio's toolbox search. -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBox x:Name="SearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                             Padding="22,3,24,3"
                                             VerticalContentAlignment="Center"
                                             PreviewKeyDown="OnSearchKeyDown"
                                             ToolTip="Only the pictures whose name or folder holds this - a serial number, FAIL, a day (Ctrl+F). Down goes to the list; Esc clears." />

                                    <Image Source="{StaticResource Icon.ph_search}"
                                           Width="13"
                                           Height="13"
                                           Margin="6,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />

                                    <TextBlock Text="Search names"
                                               Margin="24,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontStyle="Italic"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Style="{StaticResource ToolbarButton}"
                                            Width="18"
                                            Height="18"
                                            Padding="0"
                                            Margin="0,0,3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ToolTip="Clear the search (Esc)"
                                            Click="OnClearSearch"
                                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{StaticResource Icon.ph_clear}" Width="10" Height="10" />
                                    </Button>
                                </Grid>

                                <!-- Sort: what by, and which way. The viewers step along in this order. -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Sort"
                                               VerticalAlignment="Center"
                                               Margin="2,0,8,0"
                                               Foreground="{StaticResource Text.Secondary}" />
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource ToolbarTextButton}"
                                            Margin="4,0,0,0"
                                            Command="{Binding ReverseSortCommand}"
                                            ToolTip="{Binding SortDirectionText}"
                                            ToolTipService.ShowOnDisabled="True">
                                        <TextBlock Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Primary}">
                                            <Run Text="{Binding SortArrow, Mode=OneWay}" FontWeight="Bold" />
                                            <Run Text="{Binding SortDirectionText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Button>
                                    <ComboBox ItemsSource="{x:Static local:BrowserViewModel.Sorts}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Sort}"
                                              ToolTip="What the list is sorted by. Name keeps a station's pictures in the order taken, under a heading for each day." />
                                </DockPanel>

                                <TextBlock DockPanel.Dock="Top"
                                           Text="{Binding SortProgress}"
                                           FontSize="11"
                                           Margin="2,0,0,6"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Visibility="{Binding SortProgress, Converter={StaticResource NullToVisibility}}" />

                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="{Binding Problem}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           Foreground="#DB5C5C"
                                           Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />

                                <Grid>
                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Text="Open a folder of pictures - a station's, or any other. Ctrl+O, or drop a folder here."
                                               Visibility="{Binding HasFolder, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Text="{Binding EmptyText}"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                                    <!--
                                        Grouped by sub-folder - a station's days - under a heading
                                        each; the folder's own pictures, last, have none.
                                    -->
                                    <ListBox x:Name="FileList"
                                             ItemsSource="{Binding Files}"
                                             SelectionMode="Extended"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource Text.Primary}"
                                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ContextMenu="{StaticResource FileMenu}"
                                             SelectionChanged="OnFilesSelectionChanged">
                                        <ListBox.InputBindings>
                                            <KeyBinding Key="C" Modifiers="Control" Command="{x:Static local:ViewerWindow.CopyNameCommand}" />
                                            <KeyBinding Key="C" Modifiers="Control+Shift" Command="{x:Static local:ViewerWindow.CopyPathCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="2,8,4,3">
                                                            <DockPanel.Style>
                                                                <Style TargetType="DockPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </DockPanel.Style>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding ItemCount}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource Text.Secondary}" />
                                                            <Image Source="{StaticResource Icon.ph_open}" Width="13" Height="13" Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource Text.Secondary}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ImageFileItem}">
                                                <DockPanel ToolTip="{Binding Description}" Background="Transparent">
                                                    <!-- The file's icon: a page with a picture on it, and its type. -->
                                                    <Grid DockPanel.Dock="Left" Width="24" Height="28" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <Path Data="M4,1.5 H15 L20.5,7 V26.5 H4 Z"
                                                              Fill="#24262B"
                                                              Stroke="#9AA0AA"
                                                              StrokeThickness="1.2"
                                                              StrokeLineJoin="Round" />
                                                        <Path Data="M15,1.5 V7 H20.5"
                                                              Stroke="#9AA0AA"
                                                              StrokeThickness="1.2"
                                                              StrokeLineJoin="Round" />
                                                        <Path Data="M7,15 L10,11 L12.2,13.6 L14,11.8 L17.5,15 Z"
                                                              Fill="#9AA0AA" />
                                                        <Border Style="{StaticResource FileKindBadge}">
                                                            <TextBlock Text="{Binding Kind}" FontSize="7.5" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource VerdictBadge}">
                                                        <TextBlock Text="{Binding Verdict}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="●"
                                                               FontSize="9"
                                                               Margin="0,3,5,0"
                                                               VerticalAlignment="Top"
                                                               Foreground="#D9A33A"
                                                               ToolTip="Measured, and not saved yet (Ctrl+S)"
                                                               Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailsText}"
                                                                   FontSize="10"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource Text.Secondary}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                    <!-- The viewers -->
                    <avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocument Title="Pictures" ContentId="pictures" CanClose="False">
                            <ItemsControl ItemsSource="{Binding Tiles}" Margin="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TileViewModel}">
                                        <Border Margin="2" BorderBrush="{StaticResource Surface.Border}" BorderThickness="1">
                                            <DockPanel>
                                                <!-- What it is, and how it went -->
                                                <Border DockPanel.Dock="Top"
                                                        Background="{StaticResource Surface.Panel}"
                                                        Padding="8,3"
                                                        ToolTip="{Binding Details}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource VerdictBadge}">
                                                            <TextBlock Text="{Binding Verdict}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Caption}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Text.Primary}" />
                                                    </DockPanel>
                                                </Border>

                                                <TextBlock DockPanel.Dock="Bottom"
                                                           Text="{Binding Problem}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Margin="8,3"
                                                           Foreground="#DB5C5C"
                                                           Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />

                                                <Grid>
                                                    <controls:ImageViewer ImageSource="{Binding Picture}"
                                                                          Shapes="{Binding Shapes}"
                                                                          Measurements="{Binding Measurements, Mode=TwoWay}"
                                                                          SaveName="{Binding File.Name}" />
                                                    <TextBlock Text="Choose a picture in the list"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </avalonDock:LayoutDocument>
                    </avalonDock:LayoutDocumentPane>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</Window>
