<Project Sdk="Microsoft.NET.Sdk">

  <!--
    sirius-run: a recipe over a folder of images, from a script or a
    scheduled task, without the application's window. A console program of
    its own rather than a switch on the windowed one, because a windowed
    program cannot write to the console it was started from, and a script
    cannot wait for it or read its exit code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sirius.Runner</RootNamespace>
    <AssemblyName>sirius-run</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\..\res\Sirius Stu.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Sirius.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sirius.Core\Sirius.Core.csproj" />
    <ProjectReference Include="..\Sirius.Vision\Sirius.Vision.csproj" />
    <ProjectReference Include="..\Sirius.Cameras.Basler\Sirius.Cameras.Basler.csproj" />
  </ItemGroup>

</Project>
