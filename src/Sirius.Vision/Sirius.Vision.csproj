<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sirius.Vision</RootNamespace>

    <!-- Copying a custom node's picture into a Mat without an extra array. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Emgu.CV" />
    <!-- Flows transitively to the app and test projects so natives get copied. -->
    <PackageReference Include="Emgu.CV.runtime.windows" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests exercise helpers like kernel parsing without making them public API. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Sirius.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Tesseract language data, beside the executable where Emgu looks for
    it. The fast model: a tenth the size of the standard one, and the
    difference on a printed part number is not worth 19 MB in every zip.
    Apache 2.0, same as the engine.
  -->
  <ItemGroup>
    <Content Include="../../res/tessdata/eng.traineddata"
             Link="tessdata/eng.traineddata"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Python custom node SDK and the worker that runs each library, in a
    python folder beside the executable. Library authors import
    sirius_nodes from there, or copy it.
  -->
  <ItemGroup>
    <Content Include="Python/sirius_nodes.py;Python/sirius_worker.py"
             Link="python/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sirius.Core\Sirius.Core.csproj" />
    <ProjectReference Include="..\Sirius.Plugins\Sirius.Plugins.csproj" />
  </ItemGroup>

</Project>
