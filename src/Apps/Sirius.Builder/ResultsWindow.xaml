<Window x:Class="Sirius.Builder.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirius.Builder"
        Title="Results"
        Width="640"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        The results a station gives its parts (F33): a row each - colour,
        name, PLC code, how it counts - best first, and which a late part
        and one not inspected get. Written when OK is pressed.
    -->
    <Window.Resources>
        <DataTemplate x:Key="Swatch">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="2" Background="{Binding}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,14,16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,0,0,10"
                   Foreground="{StaticResource Text.Secondary}" />

        <!-- Column headings -->
        <Grid Grid.Row="1" Margin="4,0,4,4" TextElement.Foreground="{StaticResource Text.Secondary}" TextElement.FontSize="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="122" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Colour" />
            <TextBlock Grid.Column="1" Text="Name" Margin="6,0,0,0" />
            <TextBlock Grid.Column="2" Text="PLC code" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="Counts as" Margin="6,0,0,0" />
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="1"
                Background="{StaticResource Surface.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ResultRow}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="122" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{x:Static local:ResultsViewModel.Colours}"
                                          SelectedItem="{Binding Colour}"
                                          ItemTemplate="{StaticResource Swatch}"
                                          ToolTip="How it is shown on screens and in Sirius IV" />
                                <TextBox Grid.Column="1"
                                         Margin="6,0,0,0"
                                         MaxLength="16"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Letters, digits and '-': it goes into the pictures' names - _REVIEW" />
                                <TextBox Grid.Column="2"
                                         Margin="6,0,0,0"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="The number the PLC is sent for it: Inspect's Code" />
                                <ComboBox Grid.Column="3"
                                          Margin="6,0,0,0"
                                          ItemsSource="{x:Static local:ResultsViewModel.Countings}"
                                          SelectedItem="{Binding Counting}"
                                          ToolTip="Pass and Fail make the yield; Not counted - no product, a part to decide - is counted on its own" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button Content="↑"
                                            Width="26"
                                            ToolTip="Better: up the list"
                                            Command="{Binding DataContext.UpCommand, ElementName=RowList}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="↓"
                                            Width="26"
                                            Margin="4,0,0,0"
                                            ToolTip="Worse: down the list"
                                            Command="{Binding DataContext.DownCommand, ElementName=RowList}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Remove"
                                            Margin="4,0,0,0"
                                            Padding="8,1"
                                            Command="{Binding DataContext.RemoveCommand, ElementName=RowList}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add Result" MinWidth="100" Command="{Binding AddCommand}" />
            <Button Content="PASS and FAIL"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Command="{Binding StandardCommand}"
                    ToolTip="Back to the two results a station has unless chosen" />
        </StackPanel>

        <!-- A part missed -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="A late part is" VerticalAlignment="Center" />
            <ComboBox x:Name="LateBox"
                      Grid.Row="0" Grid.Column="1"
                      Margin="0,2"
                      ItemsSource="{Binding MissedChoices}"
                      SelectedItem="{Binding LateRow}" />
            <TextBlock Grid.Row="0" Grid.Column="2"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Text.Secondary}"
                       Text="no result before Inspect's deadline" />

            <TextBlock Grid.Row="1" Text="A part not inspected is" VerticalAlignment="Center" />
            <ComboBox x:Name="NotInspectedBox"
                      Grid.Row="1" Grid.Column="1"
                      Margin="0,2"
                      ItemsSource="{Binding MissedChoices}"
                      SelectedItem="{Binding NotInspectedRow}" />
            <TextBlock Grid.Row="1" Grid.Column="2"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Text.Secondary}"
                       Text="the station busy or faulted, or a set not completed" />
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#DB5C5C"
                   Text="{Binding Problem}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="88" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
