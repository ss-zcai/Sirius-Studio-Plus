<Window x:Class="Sirius.IV.RoisFromAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROIs from All Pictures"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        Which rectangles to cut: each picture's own - where they were drawn -
        or the ones on the picture shown, cut from every picture listed; and
        where the crops go, a folder of their own beside the pictures.
    -->
    <StackPanel Margin="16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <TextBlock Text="Cut" FontWeight="SemiBold" Margin="0,0,0,6" />

        <!-- MaxWidth, or the radio button gives its text all the room it asks for and it runs off the edge. -->
        <RadioButton x:Name="OwnOption" GroupName="Which" Margin="0,2">
            <TextBlock x:Name="OwnText" TextWrapping="Wrap" MaxWidth="470" />
        </RadioButton>
        <TextBlock Margin="20,0,0,6"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Drawn and saved, or drawn and not saved yet. Pictures without any are passed over." />

        <RadioButton x:Name="SameOption" GroupName="Which" Margin="0,6,0,2">
            <TextBlock x:Name="SameText" TextWrapping="Wrap" MaxWidth="470" />
        </RadioButton>
        <TextBlock Margin="20,0,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="The same places on every picture - for a set of training images." />

        <TextBlock Text="Save into" FontWeight="SemiBold" Margin="0,14,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" MinWidth="80" Margin="6,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock Margin="0,8,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="A folder of their own, made if it is not there - beside the pictures rather than among them, so they are not listed with them. Each crop is named picture-1, picture-2…, upright, in its picture's own format and bits: a 12-bit TIF gives 12-bit TIFs." />

        <TextBlock x:Name="ProblemText"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Foreground="#DB5C5C"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cut" MinWidth="88" IsDefault="True" Click="OnCut" />
            <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
