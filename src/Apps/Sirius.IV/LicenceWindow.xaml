<Window x:Class="Sirius.IV.LicenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sirius IV Licence"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        How the licence stands; this PC's machine ID, to send for a code;
        and where the code goes.
    -->
    <StackPanel Margin="16,14,16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Text="Machine ID" Margin="0,0,0,4" Foreground="{StaticResource Text.Secondary}" />
        <DockPanel Margin="0,0,0,14">
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" MinWidth="72" Margin="8,0,0,0" Click="OnCopy" />
            <TextBox x:Name="MachineBox" IsReadOnly="True" FontFamily="Consolas" FontSize="14" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock Text="Licence code" Margin="0,0,0,4" Foreground="{StaticResource Text.Secondary}" />
        <TextBox x:Name="CodeBox"
                 FontFamily="Consolas"
                 Height="76"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="OnCodeChanged" />

        <TextBlock x:Name="ProblemText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#DB5C5C"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="EnterButton" Content="Enter Code" MinWidth="96" IsDefault="True" IsEnabled="False" Click="OnEnter" />
            <Button x:Name="CloseButton" Content="Quit" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
