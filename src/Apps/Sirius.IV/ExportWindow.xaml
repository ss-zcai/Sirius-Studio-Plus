<Window x:Class="Sirius.IV.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Annotations as CSV"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        F20b: the pictures' annotation files as one CSV - a row for each
        picture (its verdict and results) or for each shape (its layer,
        place and measurements). Which pictures, and which rows; then where.
        Also asks which pictures to write with their annotations drawn on,
        without the rows.
    -->
    <StackPanel Margin="16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <TextBlock Text="Pictures" FontWeight="SemiBold" Margin="0,0,0,6" />
        <RadioButton x:Name="ChosenOption" GroupName="Pictures" Margin="0,2" />
        <RadioButton x:Name="ListedOption" GroupName="Pictures" Margin="0,2" />

        <StackPanel x:Name="RowsChoice">
            <TextBlock Text="One row for each" FontWeight="SemiBold" Margin="0,14,0,6" />
            <RadioButton x:Name="PictureOption" GroupName="Rows" Margin="0,2" IsChecked="True"
                         Content="Picture - its station, time, verdict, and a column for each result" />
            <RadioButton x:Name="ShapeOption" GroupName="Rows" Margin="0,2"
                         Content="Shape - its layer, kind, place and size, and a column for each measurement" />
        </StackPanel>

        <TextBlock x:Name="Note"
                   Margin="0,12,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Every layer is exported, switched on or not. Numbers are written with a full stop, as spreadsheets in any language read them." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Export…" MinWidth="88" IsDefault="True" Click="OnExport" />
            <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
