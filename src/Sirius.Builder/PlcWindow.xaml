<Window x:Class="Sirius.Builder.PlcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirius.Builder"
        Title="{Binding Title}"
        Width="980"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}"
        Closed="OnClosed">

    <!--
        A controller's PLC: its connection tried; any address read or written
        as any type; and, for a simulated PLC, its memory - shown, set, and a
        bit flipped with a click, which is how a workflow is triggered at the
        desk. During a test run, the workflow's own log too.
    -->
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        </Style>

        <Style x:Key="Box" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="12" TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The connection -->
        <Border Grid.Row="0" Style="{StaticResource Box}">
            <StackPanel>
                <TextBlock Text="Connection" Style="{StaticResource Heading}" />
                <DockPanel>
                    <TextBlock Text="Driver" Style="{StaticResource Caption}" />
                    <ComboBox x:Name="DriverBox"
                              Width="170"
                              ItemsSource="{Binding Drivers}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding DriverKey}"
                              IsEnabled="{Binding CanChangeConnection}"
                              ToolTip="Which kind of PLC. More come with the PLC drivers." />
                    <TextBlock Text="Address" Style="{StaticResource Caption}" Margin="16,0,8,0" />
                    <TextBox x:Name="PlcAddressBox"
                             Width="190"
                             VerticalContentAlignment="Center"
                             Text="{Binding PlcAddress, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding CanChangeConnection}"
                             ToolTip="{Binding AddressHint}"
                             KeyDown="OnCommitOnEnter" />
                    <Button x:Name="TestConnectionButton"
                            Content="Test Connection"
                            Margin="12,0,0,0"
                            MinWidth="120"
                            Command="{Binding TestConnectionCommand}"
                            ToolTip="Connect with this driver, as the workflow will, and say how it went" />
                    <TextBlock Text="{Binding ConnectionStatus}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConnectionStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#5FBF7F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding AddressHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Read and write one address -->
        <Border Grid.Row="1" Style="{StaticResource Box}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Read and Write" Style="{StaticResource Heading}" />
                <WrapPanel>
                    <TextBlock Text="Address" Style="{StaticResource Caption}" />
                    <TextBox x:Name="AddressBox"
                             Width="130"
                             VerticalContentAlignment="Center"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="In the PLC's words: M0.0, MW10, MD20, DB34.20.0, 40001" />
                    <TextBlock Text="Type" Style="{StaticResource Caption}" Margin="14,0,8,0" />
                    <ComboBox x:Name="TypeBox"
                              Width="140"
                              ItemsSource="{x:Static local:PlcViewModel.Types}"
                              SelectedItem="{Binding Type}"
                              ToolTip="A bit, a 16-bit INT, a 32-bit DINT, a REAL, text…" />
                    <TextBlock Text="Length"
                               Style="{StaticResource Caption}"
                               Margin="14,0,8,0"
                               Visibility="{Binding IsString, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox Width="44"
                             VerticalContentAlignment="Center"
                             Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsString, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="ReadButton"
                            Content="Read"
                            MinWidth="70"
                            Margin="14,0,0,0"
                            Command="{Binding ReadCommand}"
                            ToolTip="Read the address from the PLC, as this type" />
                    <TextBlock Text="{Binding ReadResult}"
                               MinWidth="60"
                               Margin="10,0,0,0"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#60A5FA" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Value" Style="{StaticResource Caption}" />
                    <TextBox x:Name="ValueBox"
                             Width="130"
                             VerticalContentAlignment="Center"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="true or false for a bit; a number; text" />
                    <Button x:Name="WriteButton"
                            Content="Write"
                            MinWidth="70"
                            Margin="14,0,0,0"
                            Command="{Binding WriteCommand}"
                            ToolTip="Write the value to the PLC, as this type - as a workflow's PLC Write would" />
                    <Button x:Name="SetButton"
                            Content="Set in Simulator"
                            MinWidth="120"
                            Margin="8,0,0,0"
                            Command="{Binding SetCommand}"
                            ToolTip="Set the address in the simulated PLC, as the PLC's own program would - to raise a trigger, or give a part number"
                            Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- The simulated PLC's memory, and the logs -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Box}">
                <Grid>
                    <!-- A real PLC: what the window did. -->
                    <DockPanel Visibility="{Binding IsSimulated, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Top" Text="What was done" Style="{StaticResource Heading}" />
                        <ListBox ItemsSource="{Binding Lines}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Foreground="{StaticResource Text.Primary}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItem}" />
                    </DockPanel>

                    <!-- A simulated PLC: its memory. -->
                    <DockPanel Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right"
                                    Content="Clear"
                                    MinWidth="60"
                                    Margin="6,0,0,0"
                                    Command="{Binding ClearMemoryCommand}"
                                    ToolTip="Forget every address" />
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding PlugText}"
                                    MinWidth="80"
                                    Command="{Binding PlugCommand}"
                                    ToolTip="{Binding PlugTip}" />
                            <TextBlock Text="Simulated PLC memory" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Caption}"
                                   Text="Click a bit to flip it - the way to raise a trigger at the desk. Set any other address above. What the workflow writes appears here as it writes it." />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MemoryList" ItemsSource="{Binding Memory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MemoryRow}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Address}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource Caption}" />
                                            <Grid Grid.Column="2">
                                                <TextBlock Text="{Binding Value}"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsBit, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <Button HorizontalAlignment="Left"
                                                        MinWidth="64"
                                                        Padding="8,0"
                                                        Content="{Binding Value}"
                                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Flip this bit"
                                                        Visibility="{Binding IsBit, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Box}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- With a simulated PLC the left is its memory, so what was done is here. -->
                    <DockPanel Grid.Row="0" Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Top" Text="What was done" Style="{StaticResource Heading}" />
                        <ListBox ItemsSource="{Binding Lines}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Foreground="{StaticResource Text.Primary}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItem}" />
                    </DockPanel>

                    <!-- During a test run: the workflow's log. -->
                    <DockPanel Grid.Row="2"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasRunner, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Top" Text="Workflow" Style="{StaticResource Heading}" />
                        <ListBox x:Name="WorkflowLogList"
                                 ItemsSource="{Binding WorkflowLog}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Foreground="{StaticResource Text.Primary}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItem}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
