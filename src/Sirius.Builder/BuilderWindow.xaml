<Window x:Class="Sirius.Builder.BuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirius.Builder"
        xmlns:core="clr-namespace:Sirius.Core.Nodes;assembly=Sirius.Core"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        Title="{Binding Title}"
        Width="1600"
        Height="920"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Background}"
        Activated="OnActivated"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <!--
        Sirius Builder, laid out as Studio is: menu, toolbar, then docking
        panels - Stations and Widgets on the left, the screen in the middle,
        Properties on the right - arranged as the user leaves them. With no
        project open, a landing page instead.
    -->
    <Window.Resources>
        <!-- A toolbar button with an icon and a word. -->
        <Style x:Key="ToolbarTextButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="34" />
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding TestRunCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control" Command="{Binding BringForwardCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control" Command="{Binding SendBackwardCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Shift" Command="{Binding BringToFrontCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Shift" Command="{Binding SendToBackCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project…" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Open Project…" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Close Project" Command="{Binding CloseProjectCommand}" />
                <Separator />
                <!--
                    The project file is written as it changes - stations,
                    controllers, limits - so what there is to save is the
                    screen and the workflows: Save the one in front, Save
                    All both.
                -->
                <MenuItem Header="_Save"
                          InputGestureText="Ctrl+S"
                          ToolTip="Saves what is in front: the screen, or a workflow. Stations, controllers and limits are saved as you change them."
                          Command="{Binding SaveCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_save}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _All"
                          InputGestureText="Ctrl+Shift+S"
                          ToolTip="Saves the screen and every workflow open"
                          Command="{Binding SaveAllCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_undo}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_redo}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_cut}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_copy}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_paste}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
                <MenuItem Header="De_lete" InputGestureText="Del" Command="{Binding DeleteCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_delete}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Bring _Forward" InputGestureText="Ctrl+]" Command="{Binding BringForwardCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_bring_forward}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Send Back_ward" InputGestureText="Ctrl+[" Command="{Binding SendBackwardCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_send_backward}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Bring to F_ront" InputGestureText="Ctrl+Shift+]" Command="{Binding BringToFrontCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_bring_to_front}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Send to _Back" InputGestureText="Ctrl+Shift+[" Command="{Binding SendToBackCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Icon.ph_send_to_back}" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Screen">
                <MenuItem Header="_Reset to Standard" Command="{Binding Designer.ResetCommand}" />
            </MenuItem>
            <MenuItem Header="S_tation">
                <MenuItem Header="_Add Station…" Command="{Binding AddStationCommand}" />
                <MenuItem Header="Add from _Recipe…" Command="{Binding AddFromRecipeCommand}" />
                <Separator />
                <MenuItem Header="Open in _Studio"
                          Command="{Binding OpenInStudioCommand}"
                          CommandParameter="{Binding SelectedStation}" />
                <MenuItem Header="_Line Settings…"
                          Command="{Binding LineSettingsCommand}"
                          CommandParameter="{Binding SelectedStation}" />
                <MenuItem Header="_Image Saving…"
                          Command="{Binding ImageSavingCommand}"
                          CommandParameter="{Binding SelectedStation}" />
                <MenuItem Header="_Browse Saved Images"
                          Command="{Binding BrowseImagesCommand}"
                          CommandParameter="{Binding SelectedStation}" />
            </MenuItem>
            <MenuItem Header="_Controller">
                <MenuItem Header="_Add Controller…" Command="{Binding AddControllerCommand}" />
                <Separator />
                <MenuItem Header="Open _Workflow"
                          Command="{Binding OpenWorkflowCommand}"
                          CommandParameter="{Binding SelectedController}" />
                <MenuItem Header="_PLC…"
                          Command="{Binding PlcCommand}"
                          CommandParameter="{Binding SelectedController}" />
                <MenuItem Header="_Rename…"
                          Command="{Binding RenameControllerCommand}"
                          CommandParameter="{Binding SelectedController}" />
                <MenuItem Header="Re_move from Project…"
                          Command="{Binding RemoveControllerCommand}"
                          CommandParameter="{Binding SelectedController}" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Test Run" InputGestureText="F5" Command="{Binding TestRunCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Project" Tag="project" Click="OnShowPanelClick" />
                <MenuItem Header="_Widgets" Tag="widgets" Click="OnShowPanelClick" />
                <MenuItem Header="_Properties" Tag="properties" Click="OnShowPanelClick" />
                <Separator />
                <MenuItem Header="_Reset Layout" Click="OnResetLayoutClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Sirius Builder…" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <!-- Project -->
                <Button Style="{StaticResource ToolbarButton}" ToolTip="New project (Ctrl+N)" Command="{Binding NewProjectCommand}">
                    <Image Source="{StaticResource Icon.ph_new}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Open project (Ctrl+O)" Command="{Binding OpenProjectCommand}">
                    <Image Source="{StaticResource Icon.ph_open}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarTextButton}" ToolTip="Save what is in front (Ctrl+S): the screen, or a workflow. Stations, controllers and limits are saved as you change them" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Icon.ph_save}" Width="18" Height="18" />
                        <TextBlock Text="Save" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>

                <Separator />

                <!-- History -->
                <Button Style="{StaticResource ToolbarTextButton}" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Icon.ph_undo}" Width="18" Height="18" />
                        <TextBlock Text="Undo" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarTextButton}" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Icon.ph_redo}" Width="18" Height="18" />
                        <TextBlock Text="Redo" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>

                <Separator />

                <!-- Clipboard -->
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Cut the selected widget (Ctrl+X)" Command="{Binding CutCommand}">
                    <Image Source="{StaticResource Icon.ph_cut}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Copy the selected widget (Ctrl+C)" Command="{Binding CopyCommand}">
                    <Image Source="{StaticResource Icon.ph_copy}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Paste (Ctrl+V)" Command="{Binding PasteCommand}">
                    <Image Source="{StaticResource Icon.ph_paste}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Delete the selected widget (Del)" Command="{Binding DeleteCommand}">
                    <Image Source="{StaticResource Icon.ph_delete}" Width="18" Height="18" />
                </Button>

                <Separator />

                <!-- Arrange: what overlaps -->
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Bring forward (Ctrl+])" Command="{Binding BringForwardCommand}">
                    <Image Source="{StaticResource Icon.ph_bring_forward}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Send backward (Ctrl+[)" Command="{Binding SendBackwardCommand}">
                    <Image Source="{StaticResource Icon.ph_send_backward}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Bring to front (Ctrl+Shift+])" Command="{Binding BringToFrontCommand}">
                    <Image Source="{StaticResource Icon.ph_bring_to_front}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Send to back (Ctrl+Shift+[)" Command="{Binding SendToBackCommand}">
                    <Image Source="{StaticResource Icon.ph_send_to_back}" Width="18" Height="18" />
                </Button>

                <Separator />

                <!--
                    Reset to Standard is in the Screen menu only, where it
                    asks first: on the toolbar a stray click replaced the
                    whole design. Open in Studio is on the Stations panel.
                -->
                <Button Style="{StaticResource ToolbarTextButton}" ToolTip="Test-run the project on its saved screen, as Sirius Edge will (F5)" Command="{Binding TestRunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Icon.ph_run}" Width="18" Height="18" />
                        <TextBlock Text="Test Run" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- No project open -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Sirius Builder"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" />
            <TextBlock Margin="0,10,0,18"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Text.Secondary}"
                       Text="A project holds stations - each a camera and the recipe made for it in Sirius Studio - and the screen the operator sees. Build it here, test-run it here, and run it on the machine with Sirius Edge." />
            <StackPanel Orientation="Horizontal">
                <Button Content="New Project…" MinWidth="120" Command="{Binding NewProjectCommand}" />
                <Button Content="Open Project…" MinWidth="120" Margin="8,0,0,0" Command="{Binding OpenProjectCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- A project -->
        <avalonDock:DockingManager x:Name="Docking"
                                   Grid.Row="2"
                                   AllowMixedOrientation="True"
                                   Background="{StaticResource Surface.Background}"
                                   Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <avalonDock:DockingManager.Theme>
                <themes:Vs2013DarkTheme />
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="240">
                        <!--
                            The project: its stations, then its controllers, in
                            one list - each with its icon, its own double-click
                            and its own right-click menu.
                        -->
                        <avalonDock:LayoutAnchorablePane DockHeight="2*">
                            <avalonDock:LayoutAnchorable Title="Project" ContentId="project" CanClose="False">
                                <DockPanel Margin="6">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <!-- Add: a station, a station from a recipe, or a controller. -->
                                        <Button x:Name="AddButton"
                                                Style="{StaticResource PanelToolButton}"
                                                ToolTip="Add a station or a controller"
                                                Click="OnAddClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M7,1 L7,13 M1,7 L13,7"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6"
                                                      Width="14"
                                                      Height="14" />
                                                <Path Data="M0,0 L3,3 L6,0"
                                                      Margin="3,1,0,0"
                                                      VerticalAlignment="Center"
                                                      Stroke="{StaticResource Text.Secondary}"
                                                      StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="AddMenu">
                                                    <MenuItem Header="Add _Station…" Command="{Binding AddStationCommand}">
                                                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_camera}" Width="16" Height="16" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Add Station from _Recipe…" Command="{Binding AddFromRecipeCommand}">
                                                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_copy}" Width="16" Height="16" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Add _Controller…" Command="{Binding AddControllerCommand}">
                                                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_controller}" Width="16" Height="16" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button Style="{StaticResource PanelToolButton}"
                                                ToolTip="Open what is selected: a station's recipe in Studio, a controller's workflow here"
                                                Command="{Binding OpenSelectedCommand}">
                                            <Image Source="{StaticResource Icon.ph_sub_graph}" Width="15" Height="15" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock DockPanel.Dock="Bottom"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Text="Double-click: a station shows the screen, a controller its workflow. Right-click a station to open its recipe in Studio." />

                                    <Grid>
                                        <TextBlock TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   Text="Nothing here yet. Add a station from a recipe made in Studio, then a controller for its PLC."
                                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                                        <ListBox x:Name="ProjectList"
                                                 ItemsSource="{Binding Items}"
                                                 SelectedItem="{Binding SelectedItem}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource Text.Primary}"
                                                 ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                                 MouseDoubleClick="OnProjectItemDoubleClick">
                                            <ListBox.Resources>
                                                <!-- A station: a camera and its recipe. -->
                                                <DataTemplate DataType="{x:Type local:StationViewModel}">
                                                    <DockPanel Background="Transparent" ToolTip="{Binding RecipePath}" Margin="0,2">
                                                        <Image DockPanel.Dock="Left"
                                                               Source="{StaticResource Icon.ph_camera}"
                                                               Width="24"
                                                               Height="24"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Top" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding RecipeFile}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource Text.Secondary}" />
                                                            <TextBlock Text="recipe missing"
                                                                       FontSize="10"
                                                                       FontStyle="Italic"
                                                                       Foreground="#DB5C5C"
                                                                       Visibility="{Binding RecipeMissing, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="{Binding LineChangesText}"
                                                                       FontSize="10"
                                                                       Foreground="#D9A33A"
                                                                       ToolTip="Settings changed from a screen, used over the recipe's own - right-click for Line Settings"
                                                                       Visibility="{Binding HasLineChanges, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="{Binding SavingText}"
                                                                       FontSize="10"
                                                                       Foreground="#4FA3D9"
                                                                       ToolTip="{Binding ImagesFolder}"
                                                                       Visibility="{Binding SavesImages, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <DockPanel.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Open in _Studio"
                                                                          Command="{Binding PlacementTarget.Tag.OpenInStudioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="_Line Settings…"
                                                                          Command="{Binding PlacementTarget.Tag.LineSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="_Image Saving…"
                                                                          Command="{Binding PlacementTarget.Tag.ImageSavingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="_Browse Saved Images"
                                                                          Command="{Binding PlacementTarget.Tag.BrowseImagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="_Rename…"
                                                                          Command="{Binding PlacementTarget.Tag.RenameStationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <Separator />
                                                                <MenuItem Header="Move _Up"
                                                                          Command="{Binding PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Move _Down"
                                                                          Command="{Binding PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <Separator />
                                                                <MenuItem Header="Re_move from Project…"
                                                                          Command="{Binding PlacementTarget.Tag.RemoveStationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </DockPanel.ContextMenu>
                                                        <DockPanel.Tag>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                        </DockPanel.Tag>
                                                    </DockPanel>
                                                </DataTemplate>

                                                <!-- A controller: a PLC and its workflow. -->
                                                <DataTemplate DataType="{x:Type local:ControllerViewModel}">
                                                    <DockPanel Background="Transparent" ToolTip="{Binding WorkflowPath}" Margin="0,2">
                                                        <Image DockPanel.Dock="Left"
                                                               Source="{StaticResource Icon.ph_controller}"
                                                               Width="24"
                                                               Height="24"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Top" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding ConnectionText}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource Text.Secondary}" />
                                                            <TextBlock Text="workflow missing"
                                                                       FontSize="10"
                                                                       FontStyle="Italic"
                                                                       Foreground="#DB5C5C"
                                                                       Visibility="{Binding WorkflowMissing, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <DockPanel.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Open _Workflow"
                                                                          Command="{Binding PlacementTarget.Tag.OpenWorkflowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="_PLC…"
                                                                          Command="{Binding PlacementTarget.Tag.PlcCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="_Rename…"
                                                                          Command="{Binding PlacementTarget.Tag.RenameControllerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <Separator />
                                                                <MenuItem Header="Re_move from Project…"
                                                                          Command="{Binding PlacementTarget.Tag.RemoveControllerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </DockPanel.ContextMenu>
                                                        <DockPanel.Tag>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                        </DockPanel.Tag>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.Resources>
                                        </ListBox>
                                    </Grid>
                                </DockPanel>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!--
                            Widgets, as Studio's Toolbox: drag one onto the
                            screen to put it where it lands, or double-click
                            to add it at the top left.
                        -->
                        <avalonDock:LayoutAnchorablePane DockHeight="3*">
                            <avalonDock:LayoutAnchorable x:Name="ToolsPanel" Title="Widgets" ContentId="widgets" CanClose="False">
                                <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding IsWorkflowActive, Converter={StaticResource InverseBoolToVisibility}}">
                                    <ItemsControl ItemsSource="{x:Static local:ScreenDesignerViewModel.Tools}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:WidgetTool}">
                                                <Border Background="Transparent"
                                                        Padding="10,4,8,4"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding Description}"
                                                        PreviewMouseLeftButtonDown="OnWidgetToolMouseDown"
                                                        PreviewMouseMove="OnWidgetToolMouseMove">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding Icon, Converter={StaticResource IconKeyToImage}}"
                                                               Width="16"
                                                               Height="16"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Text.Primary}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- A workflow's nodes, by group: drag one onto the canvas, or double-click. -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding IsWorkflowActive, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl x:Name="NodeTools" ItemsSource="{Binding ActiveWorkflow.Palette}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:WorkflowPaletteGroup}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}"
                                                               Margin="10,4,0,2"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text.Secondary}" />
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type core:NodeDescriptor}">
                                                                <Border Background="Transparent"
                                                                        Padding="10,4,8,4"
                                                                        Cursor="Hand"
                                                                        ToolTip="{Binding Description}"
                                                                        PreviewMouseLeftButtonDown="OnNodeToolMouseDown"
                                                                        PreviewMouseMove="OnNodeToolMouseMove">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Source="{Binding Icon, Converter={StaticResource IconKeyToImage}}"
                                                                               Width="16"
                                                                               Height="16"
                                                                               Margin="0,0,8,0"
                                                                               VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource Text.Primary}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                </Grid>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>

                    <!-- The screen -->
                    <avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocument Title="Screen" ContentId="screen" CanClose="False">
                            <local:ScreenDesignerView x:Name="Designer" DataContext="{Binding Designer}" />
                        </avalonDock:LayoutDocument>
                    </avalonDock:LayoutDocumentPane>

                    <!-- Properties -->
                    <avalonDock:LayoutAnchorablePane DockWidth="300">
                        <avalonDock:LayoutAnchorable Title="Properties" ContentId="properties" CanClose="False">
                            <local:PropertyGridView Categories="{Binding PropertyCategories}"
                                                    Title="{Binding PropertyTitle}"
                                                    Subtitle="{Binding PropertySubtitle}" />
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- Status -->
        <Border Grid.Row="3"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource Text.Secondary}"
                       ToolTip="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
