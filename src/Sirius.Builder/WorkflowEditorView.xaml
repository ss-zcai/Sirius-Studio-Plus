<UserControl x:Class="Sirius.Builder.WorkflowEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sirius.Builder"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:Sirius.Studio.App.ViewModels;assembly=SiriusStudioPlus"
             xmlns:core="clr-namespace:Sirius.Core.Nodes;assembly=Sirius.Core"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        A controller's workflow: the nodes it can use on the left, the graph
        on Studio's canvas in the middle, the chosen node's settings on the
        right, and what the check finds along the bottom.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    </UserControl.InputBindings>

    <Grid TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- The workflow's own toolbar -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="5"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PanelToolButton}" ToolTip="Save the workflow (Ctrl+S) - a test run uses the saved file" Command="{Binding SaveCommand}">
                    <Image Source="{StaticResource Icon.ph_save}" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource PanelToolButton}" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}">
                    <Image Source="{StaticResource Icon.ph_undo}" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource PanelToolButton}" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}">
                    <Image Source="{StaticResource Icon.ph_redo}" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource PanelToolButton}" ToolTip="Delete what is selected (Del)" Command="{Binding DeleteCommand}">
                    <Image Source="{StaticResource Icon.ph_delete}" Width="15" Height="15" />
                </Button>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="Drag nodes in from the left. Wire a trigger to a trigger, a value to a value. A pass starts at a PLC Monitor or Station Result." />
            </StackPanel>
        </Border>

        <!-- The nodes a workflow can use -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{StaticResource Surface.Panel}">
            <ItemsControl ItemsSource="{Binding Palette}" Margin="0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:WorkflowPaletteGroup}">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}"
                                       Margin="10,2,0,4"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:NodeDescriptor}">
                                        <Border Background="Transparent"
                                                Padding="14,4,8,4"
                                                Cursor="Hand"
                                                ToolTip="{Binding Description}"
                                                PreviewMouseLeftButtonDown="OnPaletteMouseDown"
                                                PreviewMouseMove="OnPaletteMouseMove">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Surface.Border}" />

        <!-- The graph, on Studio's canvas -->
        <nodify:NodifyEditor x:Name="Canvas"
                             Grid.Row="1"
                             Grid.Column="2"
                             DataContext="{Binding Document}"
                             AllowDrop="True"
                             DragOver="OnCanvasDragOver"
                             Drop="OnCanvasDrop"
                             Background="{StaticResource Surface.Canvas}"
                             ItemsSource="{Binding Editor.Nodes}"
                             Connections="{Binding Editor.Connections}"
                             PendingConnection="{Binding Editor.PendingConnection}"
                             SelectedItems="{Binding Editor.SelectedItems}"
                             SelectedConnections="{Binding Editor.SelectedConnections}"
                             CanSelectMultipleConnections="True"
                             ConnectionStartedCommand="{Binding Editor.StartConnectionCommand}"
                             ConnectionCompletedCommand="{Binding Editor.CompleteConnectionCommand}"
                             DisconnectConnectorCommand="{Binding Editor.DisconnectCommand}"
                             RemoveConnectionCommand="{Binding Editor.RemoveConnectionCommand}"
                             GridCellSize="20">

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="nodify:ItemContainer">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="nodify:ItemContainer">
                                <Grid>
                                    <Border x:Name="SelectionOutline"
                                            Margin="-2"
                                            CornerRadius="6"
                                            BorderBrush="#FBBF24"
                                            BorderThickness="2"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    <ContentPresenter />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                    <nodify:Node Input="{Binding Inputs}"
                                 Output="{Binding Outputs}"
                                 Opacity="{Binding Enabled, Converter={StaticResource EnabledToOpacity}}"
                                 ContentPadding="0"
                                 ContentBrush="Transparent"
                                 Background="{Binding AccentStyle.Background}"
                                 BorderBrush="{Binding AccentStyle.Border}"
                                 Foreground="{Binding AccentStyle.Text}"
                                 BorderThickness="1"
                                 ToolTip="{Binding ToolTipText}">
                        <nodify:Node.Header>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TypeName}" FontSize="10" Opacity="0.7" />
                            </StackPanel>
                        </nodify:Node.Header>

                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                <nodify:NodeInput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                  IsConnected="{Binding IsConnected, Mode=OneWay}"
                                                  ToolTip="{Binding ToolTipText}"
                                                  Template="{StaticResource InputSocketTemplate}" />
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>

                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                <nodify:NodeOutput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                   IsConnected="{Binding IsConnected, Mode=OneWay}"
                                                   ToolTip="{Binding ToolTipText}"
                                                   Template="{StaticResource OutputSocketTemplate}" />
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>
                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                    <nodify:Connection Source="{Binding Source.Anchor}"
                                       Target="{Binding Target.Anchor}"
                                       ToolTip="{Binding Description}"
                                       IsSelectable="True"
                                       IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                       DisconnectCommand="{Binding DataContext.Editor.RemoveConnectionCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">
                        <nodify:Connection.Style>
                            <Style TargetType="nodify:Connection">
                                <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                <Setter Property="StrokeThickness" Value="2" />
                                <Setter Property="OutlineBrush" Value="Transparent" />
                                <Setter Property="OutlineThickness" Value="3.5" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Stroke" Value="#BFDBFE" />
                                        <Setter Property="StrokeThickness" Value="2.5" />
                                        <Setter Property="OutlineBrush" Value="#5560A5FA" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Stroke" Value="#FBBF24" />
                                        <Setter Property="StrokeThickness" Value="2.5" />
                                        <Setter Property="OutlineBrush" Value="#88FBBF24" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </nodify:Connection.Style>
                    </nodify:Connection>
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                    <nodify:PendingConnection Source="{Binding Source}"
                                              Target="{Binding Target}"
                                              AllowOnlyConnectors="True"
                                              EnablePreview="True"
                                              EnableSnapping="True" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>
        </nodify:NodifyEditor>

        <GridSplitter Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource Surface.Border}" />

        <!-- The chosen node's settings -->
        <Border Grid.Row="1" Grid.Column="4" Background="{StaticResource Surface.Panel}">
            <local:PropertyGridView Categories="{Binding Properties}"
                                    Title="{Binding PropertyTitle}"
                                    Subtitle="{Binding PropertySubtitle}" />
        </Border>

        <!-- What the check finds -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="5"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Text="{Binding ProblemText}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ProblemText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#5FBF7F" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                <Setter Property="Foreground" Value="#D9A33A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
