<Window x:Class="Sirius.Builder.ImageSavingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirius.Builder"
        Title="Image Saving"
        Width="620"
        Height="470"
        MinWidth="460"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        Which pictures a station keeps when it runs, in a property grid like
        the screen designer's, with where one will be written underneath.
    -->
    <Grid Margin="16,14,16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,0,0,10"
                   Foreground="{StaticResource Text.Secondary}" />

        <Border Grid.Row="1"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="1"
                Background="{StaticResource Surface.Panel}">
            <local:PropertyGridView Categories="{Binding Categories}" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="A picture will be saved as"
                       FontSize="11"
                       Foreground="{StaticResource Text.Secondary}" />
            <TextBox Text="{Binding Example, Mode=OneWay}"
                     IsReadOnly="True"
                     FontSize="11"
                     Margin="0,2,0,0"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource Text.Primary}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#DB5C5C"
                   Text="{Binding Problem}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="88" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
