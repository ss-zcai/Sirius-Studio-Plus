<Window x:Class="Sirius.Studio.App.CustomNodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Nodes"
        Width="620"
        Height="520"
        MinWidth="440"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <Grid Margin="16" TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Libraries of tools built outside Sirius Studio Plus. Libraries in a plugins folder load when the application starts; others are added here and remembered." />

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="1"
                Background="{StaticResource Surface.Panel}">
            <Grid>
                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="No custom node libraries are loaded." />

                <ScrollViewer x:Name="Scroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="LibraryList" ItemsSource="{Binding Libraries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Surface.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />

                                            <TextBlock Text="{Binding SourceText}"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       FontSize="11"
                                                       Margin="0,1,0,0" />

                                            <!-- Selectable, so a path can be copied into a bug report. -->
                                            <TextBox Text="{Binding Path, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     Margin="0,2,0,0"
                                                     FontFamily="Consolas"
                                                     FontSize="11"
                                                     Foreground="{StaticResource Text.Secondary}"
                                                     TextWrapping="Wrap"
                                                     ToolTip="{Binding Path}" />

                                            <TextBlock Text="{Binding Summary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />

                                            <ItemsControl ItemsSource="{Binding Problems}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#F59E0B"
                                                                   Margin="0,2,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Removed. Its nodes stay in the toolbox until the application restarts."
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       FontStyle="Italic"
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                VerticalAlignment="Top"
                                                Margin="12,0,0,0"
                                                Tag="{Binding}"
                                                Click="OnRemoveClick"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Name="FoldersText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}" />

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add Library…" Click="OnAddClick" />
            <Button DockPanel.Dock="Left" Content="Open Plugins Folder" Click="OnOpenFolderClick" />
            <Button DockPanel.Dock="Right"
                    Content="Close"
                    IsCancel="True"
                    IsDefault="True"
                    Click="OnCloseClick" />
        </DockPanel>
    </Grid>
</Window>
