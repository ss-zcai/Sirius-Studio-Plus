<Window x:Class="Sirius.Studio.App.NodeHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About this tool"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        Everything here is read off the node itself, so it cannot disagree
        with the tool it describes. Opened from the properties panel rather
        than shown inline: the panel is already long on a node like Find
        Blobs, and this is read once and then not again.
    -->
    <Grid TextElement.Foreground="{StaticResource Text.Primary}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
            <!--
                Runs in one TextBlock rather than TextBlocks side by side:
                runs on a line share a baseline, where separate blocks are
                aligned by their tops - and Consolas, shorter in the ascent
                than the interface font, then sits a pixel or two high.
            -->
            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource Text.Secondary}"><Run Text="{Binding Category, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TypeKey, Mode=OneWay}" FontFamily="Consolas" ToolTip="What a saved recipe records for this tool" /></TextBlock>

            <TextBlock Text="{Binding Summary}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Inputs -->
                <StackPanel Visibility="{Binding HasInputs, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="INPUTS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The socket as the canvas draws it: its colour, square for an image. -->
                                    <Border Grid.Column="0"
                                            Width="9"
                                            Height="9"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="{Binding DataTypeName, Converter={StaticResource PortTypeToCornerRadius}}"
                                            Background="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}" />

                                    <!--
                                        Columns are separate blocks, which align by
                                        their tops. Each carries a space in the other
                                        font, so every cell's line is as tall above
                                        the baseline as the others and the baselines
                                        meet.
                                    -->
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " FontFamily="Consolas" /></TextBlock>
                                    <TextBlock Grid.Column="2" Foreground="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}"><Run Text="{Binding Type, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" " /></TextBlock>
                                    <TextBlock Grid.Column="3"
                                               Margin="8,0,0,0"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource Text.Secondary}"><Run Text="{Binding Note, Mode=OneWay}" /><Run Text=" " FontFamily="Consolas" /></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Outputs -->
                <StackPanel Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="OUTPUTS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="9"
                                            Height="9"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="{Binding DataTypeName, Converter={StaticResource PortTypeToCornerRadius}}"
                                            Background="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}" />

                                    <!-- A space in the other font in each, as for the inputs. -->
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " FontFamily="Consolas" /></TextBlock>
                                    <TextBlock Grid.Column="2" Foreground="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}"><Run Text="{Binding Type, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" " /></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Parameters -->
                <StackPanel Visibility="{Binding HasParameters, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="PARAMETERS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <!-- One line of runs, so all three share a baseline. -->
                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Type, Mode=OneWay}" FontFamily="Consolas" Foreground="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}" /><Run Text="   " /><Run Text="{Binding Range, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}" /></TextBlock>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Close"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                IsCancel="True"
                IsDefault="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
