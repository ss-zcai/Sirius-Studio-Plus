<Window x:Class="Sirius.Studio.App.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="430"
        MinHeight="150"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        The shell's own message dialog. The stock MessageBox is drawn by the
        operating system in its own colours, so on a dark shell it reads as a
        different application borrowing the title - which is exactly what it
        looked like.

        The reason the stock one survived this long is that it gets the
        keyboard right for free: a default button, Escape to cancel, access
        keys, and focus where it should be. Those are reproduced here
        deliberately rather than approximated, because a dialog that cannot
        be answered from the keyboard is worse than an ugly one.
    -->
    <Grid Margin="20,18,20,16" TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                The severity mark, drawn rather than imaged: a glyph in the
                theme's own accent colours sits with the rest of the window,
                where the operating system's blue-and-white question mark did
                not.
            -->
            <Border x:Name="Glyph"
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    CornerRadius="15"
                    VerticalAlignment="Top"
                    Margin="0,0,14,0"
                    BorderThickness="2">
                <TextBlock x:Name="GlyphText"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!--
                Selectable, so the text of a failure can be copied into a bug
                report instead of retyped from a photograph of the screen.
            -->
            <TextBox x:Name="MessageText"
                     Grid.Column="1"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource Text.Primary}"
                     TextWrapping="Wrap"
                     MaxHeight="320"
                     VerticalScrollBarVisibility="Auto"
                     VerticalAlignment="Center"
                     Padding="0"
                     FontSize="13" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button x:Name="AffirmButton"
                    MinWidth="86"
                    Margin="6,0,0,0"
                    Click="OnAffirm" />
            <Button x:Name="DenyButton"
                    MinWidth="86"
                    Margin="6,0,0,0"
                    Click="OnDeny" />
            <Button x:Name="CancelButton"
                    MinWidth="86"
                    Margin="6,0,0,0"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
