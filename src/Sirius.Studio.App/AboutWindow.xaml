<Window x:Class="Sirius.Studio.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Sirius Studio Plus"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        A window rather than a MessageBox. The stock dialog is drawn by the
        operating system in its own colours, which on a dark shell reads as
        a different application borrowing the title.
    -->
    <StackPanel Margin="20" TextElement.Foreground="{StaticResource Text.Primary}">
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource Icon.ph_run}"
                   Width="28"
                   Height="28"
                   VerticalAlignment="Top"
                   Margin="0,2,12,0" />

            <StackPanel>
                <TextBlock Text="Sirius Studio Plus" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText"
                           Foreground="{StaticResource Text.Secondary}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Node-based machine vision authoring."
                   TextWrapping="Wrap"
                   Margin="0,16,0,0" />

        <TextBlock Text="Sigma Squares (Beijing) Tech Co Ltd"
                   Foreground="{StaticResource Text.Secondary}"
                   Margin="0,4,0,0" />

        <TextBlock Foreground="{StaticResource Text.Secondary}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"
                   Text="Includes third-party components; see THIRD-PARTY-NOTICES.txt beside the application." />

        <Button Content="Close"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                IsCancel="True"
                IsDefault="True"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
