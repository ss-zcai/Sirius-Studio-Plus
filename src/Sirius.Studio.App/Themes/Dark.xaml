<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:app="clr-namespace:Sirius.Studio.App"
                    xmlns:controls="clr-namespace:Sirius.Studio.App.Controls"
                    xmlns:vm="clr-namespace:Sirius.Studio.App.ViewModels">

    <!--
        Dark palette. Values are deliberately plain brushes rather than a theme
        framework: the shell is small, and the node canvas needs to stay
        readable against image content of any brightness.
    -->
    <SolidColorBrush x:Key="Surface.Background" Color="#1E1F22" />
    <SolidColorBrush x:Key="Surface.Panel" Color="#2B2D30" />
    <SolidColorBrush x:Key="Surface.Canvas" Color="#17181A" />
    <SolidColorBrush x:Key="Surface.Node" Color="#32343A" />
    <SolidColorBrush x:Key="Surface.NodeHeader" Color="#3C3F45" />
    <SolidColorBrush x:Key="Surface.Border" Color="#4A4D55" />
    <SolidColorBrush x:Key="Accent" Color="#60A5FA" />
    <SolidColorBrush x:Key="Text.Primary" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#9AA0A6" />

    <app:NodeStatusToBrushConverter x:Key="StatusToBrush" />
    <app:NullToVisibilityConverter x:Key="NullToVisibility" />
    <!-- Visible only while the bound value is absent, for placeholder text. -->
    <app:NullToVisibilityConverter x:Key="VisibleWhenNull" Invert="True" />
    <app:PortTypeToBrushConverter x:Key="PortTypeToBrush" />
    <app:IconKeyToImageConverter x:Key="IconKeyToImage" />
    <app:PortTypeToCornerRadiusConverter x:Key="PortTypeToCornerRadius" />
    <app:BooleanToOpacityConverter x:Key="EnabledToOpacity" />
    <app:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <app:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />

    <!--
        Deliberately does NOT set Foreground. An implicit style setter outranks
        an inherited value, so forcing the colour here would repaint every
        TextBlock in the app - including those inside tooltips, context menus
        and combo-box popups, which render on their own light chrome in a
        separate visual tree. Text colour is inherited from TextElement.Foreground
        on the window root instead, which popups' own styles can override.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="8,8,8,4" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Surface.Border}" />
        <Setter Property="ShowsPreview" Value="True" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#1A1B1E" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />

        <!--
            Parameter bindings commit on lost focus, so a half-typed number
            never re-runs the graph. Enter is how you say the value is
            finished without having to click somewhere else; Escape puts back
            what was there.
        -->
        <Setter Property="controls:CommitOnEnter.Enabled" Value="True" />
    </Style>

    <!--
        Popups (tooltips, context menus, combo-box drop-downs) are separate
        visual trees, so they inherit nothing from the window. Each needs its
        colours set explicitly or it falls back to the system's light chrome.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <!--
        The menu items have had a template since the main menu was built, but
        the menu itself did not - so the stock one drew underneath them,
        including the pale rail down the left that Windows reserves for
        icons and check marks. It sat over the first character of every
        label.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#1A1B1E" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="2"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#1A1B1E" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True" />

                        <!-- Covers the whole field so a click anywhere opens it. -->
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Not hit-testable, so clicks fall through to the toggle. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <Path HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{StaticResource Text.Secondary}"
                              IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="#1A1B1E"
                                    BorderBrush="{StaticResource Surface.Border}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Templated rather than styled: the stock ComboBoxItem template paints its
        own highlight from system colours, which on a dark popup leaves the
        selected row unreadable.
    -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#1A1B1E" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.NodeHeader}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="#10131A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab headers: stock template draws light-on-light here too. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
        Templated, not merely coloured. The stock button template paints its own
        hover and disabled chrome - a pale blue wash and a near-white face - and
        ignores Background in those states, so setting colours alone left the
        theme only on the resting state.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface.Node}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!--
                            RecognizesAccessKey, or an underscore in the
                            content is drawn as an underscore. The stock
                            Button template sets it; a hand-written one
                            defaults to false, so "_Yes" rendered literally
                            and Alt+Y did nothing at all - the markup looked
                            correct and the behaviour was simply absent.
                        -->
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Lift the surface and pick out the border, rather
                             than flooding the face with accent: these sit in
                             rows, and a filled hover reads as "selected". -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.NodeHeader}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A1B1E" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#26282D" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3D45" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A socket plus its port name. The shape carries the data type (square =
        image, circle = otherwise, coloured per type) and the label carries the
        port's role, so the name is free to say something useful - "Source",
        "Mask", "Result" - rather than restating the type.

        PART_Connector is the name Nodify looks for when computing a
        connection's anchor, so the visible shape must carry it; that is what
        makes wires meet the socket exactly on the node border.

        The 18px transparent square is a comfortable grab target for an 11px
        socket, and the negative outer margin of half that width centres the
        whole thing on the node's edge. To change how far the socket sits proud
        of the border, change only that margin.

        A hollow fill means nothing is wired in, so an unsatisfied required
        input is visible without reading anything.
    -->
    <ControlTemplate x:Key="InputSocketTemplate" TargetType="nodify:NodeInput">
        <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" Margin="-9,1,0,1" Background="Transparent">
                <Border x:Name="PART_Connector"
                        Width="11"
                        Height="11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="{Binding DataTypeName, Converter={StaticResource PortTypeToCornerRadius}}"
                        Background="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}"
                        BorderBrush="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}"
                        BorderThickness="1.5" />
            </Grid>
            <TextBlock Text="{Binding Title}"
                       Margin="3,0,10,0"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Text.Secondary}"
                       IsHitTestVisible="False" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsConnected" Value="False">
                <Setter TargetName="PART_Connector" Property="Background" Value="#1E1F22" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Mirrored onto the node's right edge: label first, then socket. -->
    <ControlTemplate x:Key="OutputSocketTemplate" TargetType="nodify:NodeOutput">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Title}"
                       Margin="10,0,3,0"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Text.Secondary}"
                       IsHitTestVisible="False" />
            <Grid Width="18" Height="18" Margin="0,1,-9,1" Background="Transparent">
                <Border x:Name="PART_Connector"
                        Width="11"
                        Height="11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="{Binding DataTypeName, Converter={StaticResource PortTypeToCornerRadius}}"
                        Background="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}"
                        BorderBrush="{Binding DataTypeName, Converter={StaticResource PortTypeToBrush}}"
                        BorderThickness="1.5" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsConnected" Value="False">
                <Setter TargetName="PART_Connector" Property="Background" Value="#1E1F22" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Icon-only toolbar button. The icon takes the button's Foreground, so
        the disabled trigger dims the glyph as well as any text.
    -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.Node}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Surface.Border}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.NodeHeader}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Panel contents, keyed by view-model type. A LayoutAnchorable carries
        the view-model as its Content and picks these up implicitly, so no code
        constructs controls.

        Without these the panels still open, but AvalonDock falls back to
        rendering the view-model as text - which looks like a viewer that has
        stopped showing images.
    -->
    <!--
        One node colour, as a swatch and a name. Shared by the toolbar
        dropdown and the Edit menu's submenu, so the two cannot drift.

        The swatch is the combination it applies - the node's fill inside its
        stroke - rather than a single block of colour, because the stroke is
        what carries the accent and a solid square would be showing the part
        that stays dark on purpose.
    -->
    <DataTemplate x:Key="AccentItemTemplate" DataType="{x:Type vm:NodeAccentOption}">
        <StackPanel Orientation="Horizontal">
            <Border Width="13"
                    Height="13"
                    CornerRadius="2"
                    Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    Background="{Binding Background}"
                    BorderBrush="{Binding Border}"
                    BorderThickness="2" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ImagePanelViewModel}">
        <controls:ImageViewer ImageSource="{Binding Image}"
                              ImageSizeText="{Binding SizeText}"
                              Ring="{Binding Ring, Mode=TwoWay}"
                              IsRingEnabled="{Binding IsRingEnabled}"
                              ActiveTool="{Binding ActiveTool, Mode=TwoWay}"
                              Measurements="{Binding Measurements, Mode=TwoWay}"
                              Roi="{Binding Roi, Mode=TwoWay}"
                              RoiAngle="{Binding RoiAngle, Mode=TwoWay}"
                              IsRoiEnabled="{Binding IsRoiEnabled}"
                              ProfileSource="{Binding ProfileSource}"
                              IsProfilingEnabled="{Binding IsProfilingEnabled, Mode=TwoWay}"
                              ProfileLines="{Binding ProfileLines}"
                              Shapes="{Binding Shapes}"
                              SelectedShapeIndex="{Binding SelectedShapeIndex, Mode=TwoWay}" />
    </DataTemplate>

    <!--
        A preview. The same viewer as a panel, plus the measurements when the
        port being previewed carries shapes - the picture says where they
        are, the table says what they are, and the shared selection ties a
        row to a blob.
    -->
    <DataTemplate DataType="{x:Type vm:PreviewPanelViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding TableHeight}" />
            </Grid.RowDefinitions>

            <controls:ImageViewer Grid.Row="0"
                                  ImageSource="{Binding Image}"
                                  ImageSizeText="{Binding SizeText}"
                                  Ring="{Binding Ring, Mode=TwoWay}"
                                  IsRingEnabled="{Binding IsRingEnabled}"
                                  ActiveTool="{Binding ActiveTool, Mode=TwoWay}"
                                  Measurements="{Binding Measurements, Mode=TwoWay}"
                                  Roi="{Binding Roi, Mode=TwoWay}"
                                  RoiAngle="{Binding RoiAngle, Mode=TwoWay}"
                                  IsRoiEnabled="{Binding IsRoiEnabled}"
                                  ProfileSource="{Binding ProfileSource}"
                                  IsProfilingEnabled="{Binding IsProfilingEnabled, Mode=TwoWay}"
                                  ProfileLines="{Binding ProfileLines}"
                                  Shapes="{Binding Shapes}"
                                  SelectedShapeIndex="{Binding SelectedShapeIndex, Mode=TwoWay}" />

            <GridSplitter Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Surface.Border}"
                          Visibility="{Binding ShowsShapeTable, Converter={StaticResource BoolToVisibility}}" />

            <controls:ShapeTableControl Grid.Row="2"
                                        Data="{Binding Shapes}"
                                        SelectedIndex="{Binding SelectedShapeIndex, Mode=TwoWay}"
                                        Visibility="{Binding ShowsShapeTable, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HistogramPanelViewModel}">
        <controls:HistogramControl Data="{Binding Data}" Margin="8" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProfilePanelViewModel}">
        <controls:ProfileControl Data="{Binding Data}" Margin="8" />
    </DataTemplate>

    <!--
        A profile line drawn on the image viewer. Same chart, but with the band
        control beside it: each line averages over its own width.
    -->
    <DataTemplate DataType="{x:Type vm:ProfileLinePanelViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="10,6,10,0">
                <TextBlock DockPanel.Dock="Left"
                           Text="Band"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           FontSize="11"
                           Foreground="{StaticResource Text.Secondary}" />

                <!--
                    Bound to plain numbers rather than to ComboBoxItems holding
                    TextBlocks. A generated item inherits the theme foreground
                    through its ContentPresenter; a hand-written TextBlock does
                    not reliably do so in the closed selection box, and came out
                    black on the dark panel.
                -->
                <ComboBox DockPanel.Dock="Left"
                          Width="88"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding BandOptions}"
                          SelectedItem="{Binding Thickness, Mode=TwoWay}"
                          ItemStringFormat="{}{0} px"
                          ToolTip="Width of the band averaged across the line" />
            </DockPanel>

            <controls:ProfileControl Data="{Binding Data}" Margin="8,4,8,6" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ShapeTablePanelViewModel}">
        <controls:ShapeTableControl Data="{Binding Data}"
                                    SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
    </DataTemplate>

    <!--
        DataGrid. Like every other stock control here it draws itself from
        system colours, so cells, headers, rows and selection all need saying
        explicitly - otherwise the table arrives white on a dark panel.
    -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#1C1D21" />
        <Setter Property="HorizontalGridLinesBrush" Value="#2A2C31" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowHeight" Value="22" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Surface.NodeHeader}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Surface.Border}"
                            BorderThickness="0,0,1,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#10131A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <!--
        Scroll bars. The stock ones are drawn from system colours and stay
        light against the dark panels, so both orientations are templated.

        Styled as a slim track with no stepping arrows: the arrows add width,
        are rarely used, and their glyphs would need theming of their own.
    -->
    <Style x:Key="ScrollBarTrackButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <!-- Transparent, not null: a null background is not hit-testable,
                         and paging by clicking the track would stop working. -->
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="#5A5D66"
                            CornerRadius="3"
                            Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#7A7D88" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource ScrollBarTrackButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource ScrollBarTrackButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="MinHeight" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <!-- Not reversed horizontally: left is the low end. -->
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource ScrollBarTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource ScrollBarTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Slider. The stock template draws a chunky light thumb on a thin light
        rail - the most obviously unthemed control in the shell.

        Built as a rail, a filled portion and a round thumb. The filled part is
        the decrease repeat button rather than Slider.SelectionRange, which only
        renders when IsSelectionRangeEnabled is set and means something else.
    -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob"
                             Fill="{StaticResource Accent}"
                             Stroke="#1A1B1E"
                             StrokeThickness="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="#93C5FD" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="#BFDBFE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFilledBar" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Background="{StaticResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmptyBar" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <!-- Transparent, not null: clicking the track must still page. -->
                    <Border Height="14" Background="Transparent" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="20" Background="Transparent">
                        <Border Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="#3A3D45" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource SliderFilledBar}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource SliderEmptyBar}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Check box. The stock one is a white system box with a black tick, which
        reads as a hole punched in a dark panel.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="15"
                                Height="15"
                                CornerRadius="3"
                                Background="#1A1B1E"
                                BorderBrush="{StaticResource Surface.Border}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick"
                                  Data="M 2,6 L 5.5,9.5 L 11,3"
                                  Stroke="#10131A"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="15" Height="15" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring"
                                     Fill="#1A1B1E"
                                     Stroke="{StaticResource Surface.Border}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot"
                                     Width="7"
                                     Height="7"
                                     Fill="{StaticResource Accent}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="#3A3D45" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <StackPanel>
                        <ContentPresenter ContentSource="Header"
                                          TextElement.Foreground="{StaticResource Text.Secondary}"
                                          TextElement.FontWeight="SemiBold"
                                          Margin="0,0,0,6" />
                        <Border Background="#22000000"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Toolbar toggle, for the viewer's tool selection. Shares the icon-button
        shape but stays lit while its tool is active, so the current mode is
        visible without reading the cursor.
    -->
    <Style x:Key="ViewerToolButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.Node}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Surface.Border}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3360A5FA" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The image viewer's toolbar.

        Its own style rather than one based on the stock ToolBar, for two
        reasons. The default carries chrome this does not want - a drag
        gripper and a rounded bevel - and, less obviously, the default style
        also carries a resource dictionary that restyles every Button,
        ToggleButton and ComboBox placed inside it. Replacing the style
        outright leaves the children looking like the rest of the
        application instead of like a Windows toolbar.

        What is kept is the part worth having: ToolBarPanel measures what
        fits on one line and moves the remainder into the overflow panel,
        reparenting as the viewer is resized.
    -->
    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToolBarPanel x:Name="PART_ToolBarPanel"
                                      Grid.Column="0"
                                      Orientation="Horizontal"
                                      IsItemsHost="True"
                                      ClipToBounds="True" />

                        <!--
                            Hidden until something actually overflows, so a
                            viewer with room shows no sign of the mechanism.
                        -->
                        <ToggleButton x:Name="OverflowButton"
                                      Grid.Column="1"
                                      Style="{StaticResource ViewerToolButton}"
                                      ClickMode="Press"
                                      Visibility="Collapsed"
                                      ToolTip="More tools"
                                      IsChecked="{Binding IsOverflowOpen,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                            <TextBlock Text="&#x22EF;"
                                       FontSize="15"
                                       Margin="0,-3,0,0"
                                       Foreground="{StaticResource Text.Primary}" />
                        </ToggleButton>

                        <Popup x:Name="OverflowPopup"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="False"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=OverflowButton}"
                               IsOpen="{Binding IsOverflowOpen,
                                        RelativeSource={RelativeSource TemplatedParent},
                                        Mode=TwoWay}">
                            <Border Background="{StaticResource Surface.Panel}"
                                    BorderBrush="{StaticResource Surface.Border}"
                                    BorderThickness="1"
                                    Padding="3">
                                <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel"
                                                      Focusable="True"
                                                      FocusVisualStyle="{x:Null}"
                                                      WrapWidth="220"
                                                      KeyboardNavigation.TabNavigation="Cycle"
                                                      KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowItems" Value="True">
                            <Setter TargetName="OverflowButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbox accordion header -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderBorder"
                                            Background="{StaticResource Surface.Node}"
                                            BorderBrush="{StaticResource Surface.Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Chevron"
                                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                                  Fill="{StaticResource Text.Secondary}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z" />
                                            <Setter TargetName="Chevron" Property="Fill" Value="{StaticResource Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Surface.NodeHeader}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{StaticResource Text.Primary}"
                                              TextElement.FontWeight="SemiBold" />
                        </ToggleButton>

                        <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Menus are templated, not merely styled. The stock MenuItem template
        builds its submenu popup from system chrome, so setting Background on
        the item leaves the drop-down white with unreadable text no matter what
        the foreground says.
    -->
    <ControlTemplate x:Key="MenuTopLevelHeaderTemplate" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="10,5">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   Focusable="False">
                <Border Background="#1A1B1E"
                        BorderBrush="{StaticResource Surface.Border}"
                        BorderThickness="1"
                        Padding="0,3">
                    <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.NodeHeader}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.NodeHeader}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubmenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  Margin="22,6,14,6"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding InputGestureText}"
                           Margin="0,6,16,6"
                           FontSize="11"
                           Foreground="{StaticResource Text.Secondary}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#10131A" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubmenuHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  Margin="22,6,14,6"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <Path Grid.Column="1"
                      Data="M 0 0 L 4 4 L 0 8 Z"
                      Fill="{StaticResource Text.Secondary}"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0" />
                <Popup x:Name="PART_Popup"
                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                       Placement="Right"
                       AllowsTransparency="True"
                       Focusable="False">
                    <Border Background="#1A1B1E"
                            BorderBrush="{StaticResource Surface.Border}"
                            BorderThickness="1"
                            Padding="0,3">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#10131A" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template" Value="{StaticResource MenuSubmenuItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuTopLevelHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuTopLevelHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuSubmenuHeaderTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Separators inside a menu use their own key, not the plain Separator style. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource Surface.Border}" Margin="8,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Surface.Border}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
