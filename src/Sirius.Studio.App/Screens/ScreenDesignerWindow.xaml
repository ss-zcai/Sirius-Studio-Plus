<Window x:Class="Sirius.Studio.App.Screens.ScreenDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:screens="clr-namespace:Sirius.Studio.App.Screens"
        xmlns:core="clr-namespace:Sirius.Core.Screens;assembly=Sirius.Core"
        Title="{Binding Title}"
        Width="1400"
        Height="880"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}"
        PreviewKeyDown="OnPreviewKeyDown"
        Activated="OnActivated"
        Closing="OnClosing">

    <!--
        The screen designer. Palette on the left, the screen in the middle
        at a size that fits, the selected widget's properties on the right,
        and along the bottom what the screen cannot find.
    -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,3" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        </Style>

        <!-- The grid the widgets snap to, every 10 units with a stronger line every 50. -->
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,50,50" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#141517">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,50,50" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1E2023" Thickness="0.5" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="10,0" EndPoint="10,50" />
                                <LineGeometry StartPoint="20,0" EndPoint="20,50" />
                                <LineGeometry StartPoint="30,0" EndPoint="30,50" />
                                <LineGeometry StartPoint="40,0" EndPoint="40,50" />
                                <LineGeometry StartPoint="0,10" EndPoint="50,10" />
                                <LineGeometry StartPoint="0,20" EndPoint="50,20" />
                                <LineGeometry StartPoint="0,30" EndPoint="50,30" />
                                <LineGeometry StartPoint="0,40" EndPoint="50,40" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2A2C30" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="0,50" />
                                <LineGeometry StartPoint="0,0" EndPoint="50,0" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- A resize handle: a small square, its edge in the Tag. -->
        <Style x:Key="Handle" TargetType="Rectangle">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="#5B8DD6" />
            <Setter Property="Stroke" Value="#DCE8F7" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" ToolTip="Save the screen (Ctrl+S)" Command="{Binding SaveCommand}" MinWidth="64" />
                    <Button Content="Undo" ToolTip="Ctrl+Z" Command="{Binding UndoCommand}" Margin="6,0,0,0" MinWidth="56" />
                    <Button Content="Redo" ToolTip="Ctrl+Y" Command="{Binding RedoCommand}" Margin="4,0,0,0" MinWidth="56" />
                    <Border Width="1" Margin="8,2" Background="{StaticResource Surface.Border}" />
                    <Button Content="Duplicate" ToolTip="Ctrl+D" Command="{Binding DuplicateCommand}" MinWidth="70" />
                    <Button Content="Delete" ToolTip="Delete" Command="{Binding DeleteCommand}" Margin="4,0,0,0" MinWidth="60" />
                    <Button Content="To Front" Command="{Binding BringToFrontCommand}" Margin="4,0,0,0" MinWidth="64" />
                    <Button Content="To Back" Command="{Binding SendToBackCommand}" Margin="4,0,0,0" MinWidth="64" />
                    <Border Width="1" Margin="8,2" Background="{StaticResource Surface.Border}" />
                    <Button Content="Reset to Standard"
                            ToolTip="Lay the screen out again from what the stations publish"
                            Command="{Binding ResetCommand}" />
                    <Button Content="Save and Run"
                            Margin="6,0,0,0"
                            ToolTip="Save the screen and show the project running on it"
                            Click="OnRunClick" />
                    <Border Width="1" Margin="8,2" Background="{StaticResource Surface.Border}" />
                    <TextBlock Text="Screen" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Width}" Width="54" ToolTip="Screen width, in its own units; it is scaled to the display" />
                    <TextBlock Text=" × " VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" />
                    <TextBox Text="{Binding Height}" Width="54" ToolTip="Screen height" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Text.Secondary}" />
            </DockPanel>
        </Border>

        <!-- Palette -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,0,1,0"
                Padding="8">
            <StackPanel>
                <TextBlock Text="WIDGETS" FontSize="10" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Kinds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Margin="0,0,0,4"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,4"
                                    ToolTip="Click to add, or drag onto the screen"
                                    Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    PreviewMouseLeftButtonDown="OnPaletteMouseDown"
                                    PreviewMouseMove="OnPaletteMouseMove" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="Drag to move, the handles to resize. Arrow keys nudge; Delete removes; Ctrl+D duplicates." />
            </StackPanel>
        </Border>

        <!-- The screen -->
        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1" Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource Surface.Canvas}"
                      SizeChanged="OnScrollerSizeChanged">
            <Border Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                </Border.LayoutTransform>
                <ItemsControl x:Name="DesignCanvas"
                              ItemsSource="{Binding Widgets}"
                              Width="{Binding Width}"
                              Height="{Binding Height}"
                              Background="{StaticResource GridBrush}"
                              Focusable="True"
                              AllowDrop="True"
                              Drop="OnCanvasDrop"
                              MouseLeftButtonDown="OnCanvasMouseDown"
                              MouseMove="OnCanvasMouseMove"
                              MouseLeftButtonUp="OnCanvasMouseUp"
                              LostMouseCapture="OnCanvasLostCapture">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Width" Value="{Binding Width}" />
                            <Setter Property="Height" Value="{Binding Height}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type screens:DesignWidgetViewModel}">
                            <Grid Background="Transparent" Cursor="SizeAll">
                                <Border x:Name="Body"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        Background="#262A30"
                                        BorderBrush="#4A4D55">
                                    <Grid>
                                        <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="2" />
                                        <StackPanel VerticalAlignment="Center" Margin="6,2">
                                            <TextBlock x:Name="KindText"
                                                       Text="{Binding KindLabel}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource Text.Secondary}" />
                                            <TextBlock x:Name="CaptionText"
                                                       Text="{Binding Caption}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource Text.Primary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Handles, while selected -->
                                <Grid x:Name="Handles" Visibility="Collapsed" Margin="-5">
                                    <Rectangle Style="{StaticResource Handle}" Tag="TL" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
                                    <Rectangle Style="{StaticResource Handle}" Tag="T" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeNS" />
                                    <Rectangle Style="{StaticResource Handle}" Tag="TR" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
                                    <Rectangle Style="{StaticResource Handle}" Tag="L" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE" />
                                    <Rectangle Style="{StaticResource Handle}" Tag="R" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeWE" />
                                    <Rectangle Style="{StaticResource Handle}" Tag="BL" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
                                    <Rectangle Style="{StaticResource Handle}" Tag="B" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeNS" />
                                    <Rectangle Style="{StaticResource Handle}" Tag="BR" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Handles" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#5B8DD6" />
                                    <Setter TargetName="Body" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:WidgetKind.Text}">
                                    <Setter TargetName="Body" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#3A3D44" />
                                    <Setter TargetName="KindText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CaptionText" Property="FontSize" Value="{Binding Widget.FontSize}" />
                                    <Setter TargetName="CaptionText" Property="HorizontalAlignment" Value="Left" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:WidgetKind.Image}">
                                    <Setter TargetName="Body" Property="Background" Value="#17181A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:WidgetKind.Verdict}">
                                    <Setter TargetName="Body" Property="Background" Value="#1E3A24" />
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#6DBF4A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:WidgetKind.Button}">
                                    <Setter TargetName="Body" Property="Background" Value="#3C3F45" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:WidgetKind.Logo}">
                                    <Setter TargetName="Body" Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- Properties of the selected widget -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                <Grid>
                    <TextBlock Text="Select a widget to set what it shows, or add one from the left."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Secondary}"
                               Visibility="{Binding Selected, Converter={StaticResource VisibleWhenNull}}" />

                    <StackPanel DataContext="{Binding Selected}"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" FontSize="14" />

                        <StackPanel Visibility="{Binding HasStation, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Station" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding StationOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding StationValue}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Shows" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Choices}"
                                      SelectedItem="{Binding Choice}"
                                      ToolTip="Published names first; choosing anything else publishes it">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Display}" />
                                            <TextBlock Text="  (publishes it)"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       Visibility="{Binding IsPublished, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding NameProblem}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       Foreground="#D9A33A"
                                       Visibility="{Binding NameProblem, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Does" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Action}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TextLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Text}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasNumberFormat, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Number format (e.g. 0.00; blank for up to 3 decimals)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Format}" />
                            <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Unit}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Picture (copied into the project)" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="4,0,0,0" Command="{Binding BrowseCommand}" />
                                <TextBox Text="{Binding File}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasFontSize, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Font size" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FontSize}" Width="60" HorizontalAlignment="Left" />
                        </StackPanel>

                        <TextBlock Text="Position and size" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
                        <UniformGrid Columns="4">
                            <TextBox Text="{Binding EditX}" ToolTip="X" Margin="0,0,3,0" />
                            <TextBox Text="{Binding EditY}" ToolTip="Y" Margin="0,0,3,0" />
                            <TextBox Text="{Binding EditWidth}" ToolTip="Width" Margin="0,0,3,0" />
                            <TextBox Text="{Binding EditHeight}" ToolTip="Height" />
                        </UniformGrid>
                        <UniformGrid Columns="4">
                            <TextBlock Text="x" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                            <TextBlock Text="y" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                            <TextBlock Text="width" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                            <TextBlock Text="height" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- What the screen cannot find -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock Text="{Binding ProblemText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ProblemText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                <Setter Property="Foreground" Value="#D9A33A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
