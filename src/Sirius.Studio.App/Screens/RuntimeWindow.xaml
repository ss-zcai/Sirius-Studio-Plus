<Window x:Class="Sirius.Studio.App.Screens.RuntimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:screens="clr-namespace:Sirius.Studio.App.Screens"
        xmlns:controls="clr-namespace:Sirius.Studio.App.Controls"
        Title="Sirius Edge"
        Width="1296"
        Height="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Canvas}"
        Closing="OnClosing"
        KeyDown="OnKeyDown">

    <!--
        A project's screen, running. The screen is laid out on a canvas of its
        own size and scaled as a whole to the window, so it looks the same on
        any display. Along the bottom: anything the screen or a station could
        not find, and the way out.
    -->
    <Window.Resources>
        <!-- Fixed text -->
        <DataTemplate DataType="{x:Type screens:TextWidgetViewModel}">
            <TextBlock Text="{Binding Text}"
                       FontSize="{Binding FontSize}"
                       Foreground="{StaticResource Text.Primary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- Logo -->
        <DataTemplate DataType="{x:Type screens:LogoWidgetViewModel}">
            <Grid>
                <Image Source="{Binding Picture}" Stretch="Uniform" />
                <TextBlock Text="{Binding Missing}"
                           Foreground="#DB5C5C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- A station's picture -->
        <DataTemplate DataType="{x:Type screens:ImageWidgetViewModel}">
            <Border BorderBrush="{StaticResource Surface.Border}" BorderThickness="1">
                <controls:ImageViewer IsDisplayOnly="True"
                                      Background="{Binding Background}"
                                      ImageSource="{Binding Picture}"
                                      Shapes="{Binding Shapes}" />
            </Border>
        </DataTemplate>

        <!-- PASS / FAIL -->
        <DataTemplate DataType="{x:Type screens:VerdictWidgetViewModel}">
            <Border x:Name="Box"
                    CornerRadius="4"
                    BorderThickness="2"
                    Background="{StaticResource Surface.Node}"
                    BorderBrush="{StaticResource Surface.Border}"
                    ToolTip="{Binding Detail}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Word"
                               Text="{Binding Text}"
                               FontSize="{Binding FontSize}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}" />
                    <TextBlock Text="{Binding Detail}"
                               FontSize="11"
                               Margin="6,0"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Secondary}"
                               Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Look}" Value="Pass">
                    <Setter TargetName="Box" Property="Background" Value="#1E3A24" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#6DBF4A" />
                    <Setter TargetName="Word" Property="Foreground" Value="#B7E8A0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Fail">
                    <Setter TargetName="Box" Property="Background" Value="#4A1E20" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#DB5C5C" />
                    <Setter TargetName="Word" Property="Foreground" Value="#F8C4C4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Fault">
                    <Setter TargetName="Box" Property="Background" Value="#3E3420" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#D9A33A" />
                    <Setter TargetName="Word" Property="Foreground" Value="#F7EBD4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Counts -->
        <DataTemplate DataType="{x:Type screens:CounterWidgetViewModel}">
            <Border CornerRadius="4"
                    Background="{StaticResource Surface.Panel}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    Padding="8,4">
                <DockPanel VerticalAlignment="Center">
                <!-- How long an inspection takes: the average and the worst, what a deadline must allow for. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding Timing}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Text.Secondary}" />
                <UniformGrid Columns="4" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Total}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Pass" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Passed}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="#B7E8A0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding FailLabel}" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Failed}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="#F8C4C4" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Yield" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Yield}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                    </StackPanel>
                </UniformGrid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A result -->
        <DataTemplate DataType="{x:Type screens:ValueWidgetViewModel}">
            <Border CornerRadius="3"
                    Background="{StaticResource Surface.Panel}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    Padding="8,0">
                <!-- Beside: the label left, the value right. Above: the label, then the value under it. -->
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value}"
                               FontSize="{Binding FontSize}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Primary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="DockPanel.Dock" Value="Right" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLabelOnTop}" Value="True">
                                        <Setter Property="DockPanel.Dock" Value="Bottom" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Label}"
                               FontSize="{Binding FontSize}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Secondary}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- On / off, big enough for a finger -->
        <Style x:Key="SettingSwitch" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                CornerRadius="3"
                                Padding="10,2"
                                Background="{StaticResource Surface.Node}"
                                BorderBrush="{StaticResource Surface.Border}"
                                BorderThickness="1">
                            <TextBlock x:Name="Word"
                                       Text="Off"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Word" Property="Text" Value="On" />
                                <Setter TargetName="Word" Property="Foreground" Value="#B7E8A0" />
                                <Setter TargetName="Track" Property="Background" Value="#1E3A24" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6DBF4A" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Text.Secondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A setting: changed here within its limits, or only shown. The label
            beside the control or above it; the control the designer chose for
            a number - − box +, a slider, a box, or a range on one slider with
            two handles. A slider updates the setting when it is let go.
        -->
        <DataTemplate DataType="{x:Type screens:SettingWidgetViewModel}">
            <Border x:Name="Box"
                    CornerRadius="3"
                    Background="{StaticResource Surface.Panel}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    Padding="8,2"
                    ToolTip="{Binding Hint}">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding LabelWidth}" />
                        <ColumnDefinition Width="{Binding EditorWidth}" />
                    </Grid.ColumnDefinitions>

                    <!-- The label - or, after a refused change, why -->
                    <DockPanel Grid.Row="0"
                               Grid.Column="0"
                               Margin="{Binding LabelMargin}"
                               VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left"
                                Margin="0,0,6,0"
                                Padding="3,0"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{StaticResource Published.Background}"
                                BorderBrush="{StaticResource Published.Border}"
                                BorderThickness="1"
                                ToolTip="A setting">
                            <TextBlock Text="set" FontSize="9" Foreground="{StaticResource Published.Text}" />
                        </Border>
                        <TextBlock x:Name="Caption"
                                   Text="{Binding Label}"
                                   FontSize="{Binding FontSize}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Text.Secondary}" />
                    </DockPanel>

                    <Grid x:Name="Editors"
                          Grid.Row="{Binding EditorRow}"
                          Grid.Column="{Binding EditorColumn}"
                          Grid.ColumnSpan="{Binding EditorColumnSpan}"
                          HorizontalAlignment="{Binding EditorAlignment}"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding IsUnlocked}">

                        <!-- Only shown -->
                        <TextBlock Text="{Binding DisplayText}"
                                   FontSize="{Binding FontSize}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Primary}"
                                   Visibility="{Binding IsDisplayOnly, Converter={StaticResource BoolToVisibility}}" />

                        <!-- − box + -->
                        <DockPanel x:Name="Stepper" Visibility="{Binding IsStepperEditor, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Left"
                                    Content="−"
                                    MinWidth="32"
                                    FontSize="{Binding FontSize}"
                                    Padding="0"
                                    Command="{Binding LowerCommand}"
                                    ToolTip="Lower" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <Button DockPanel.Dock="Right"
                                    Content="+"
                                    MinWidth="32"
                                    FontSize="{Binding FontSize}"
                                    Padding="0"
                                    Command="{Binding RaiseCommand}"
                                    ToolTip="Raise" />
                            <TextBox Width="{Binding BoxWidth}"
                                     Margin="4,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                        </DockPanel>

                        <!-- A box alone -->
                        <DockPanel x:Name="BoxOnly" Visibility="{Binding IsBoxEditor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox MinWidth="90"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                        </DockPanel>

                        <!-- A slider, and the number it is at -->
                        <DockPanel x:Name="Slider" Visibility="{Binding IsSliderEditor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox DockPanel.Dock="Right"
                                     Width="80"
                                     Margin="8,0,0,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                            <controls:RangeSlider IsSingle="True"
                                                  MinWidth="80"
                                                  Height="28"
                                                  VerticalAlignment="Center"
                                                  Minimum="{Binding SliderMinimum}"
                                                  Maximum="{Binding SliderMaximum}"
                                                  Step="{Binding SliderStep}"
                                                  High="{Binding SliderValue, UpdateSourceTrigger=Explicit}"
                                                  ValueCommitted="OnSliderCommitted" />
                        </DockPanel>

                        <!-- A range: the low end's box, one slider with two handles, the high end's box -->
                        <DockPanel x:Name="Range" Visibility="{Binding IsRangeEditor, Converter={StaticResource BoolToVisibility}}">
                            <TextBox DockPanel.Dock="Left"
                                     Width="80"
                                     Margin="0,0,8,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     ToolTip="The low end"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox DockPanel.Dock="Right"
                                     Width="80"
                                     Margin="8,0,0,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     ToolTip="The high end"
                                     Text="{Binding HighValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                            <controls:RangeSlider MinWidth="80"
                                                  Height="28"
                                                  VerticalAlignment="Center"
                                                  Minimum="{Binding SliderMinimum}"
                                                  Maximum="{Binding SliderMaximum}"
                                                  Step="{Binding SliderStep}"
                                                  Low="{Binding SliderValue, UpdateSourceTrigger=Explicit}"
                                                  High="{Binding HighSliderValue, UpdateSourceTrigger=Explicit}"
                                                  ValueCommitted="OnSliderCommitted" />
                        </DockPanel>

                        <!-- On or off -->
                        <ToggleButton HorizontalAlignment="Right"
                                      Style="{StaticResource SettingSwitch}"
                                      FontSize="{Binding FontSize}"
                                      IsChecked="{Binding IsOn}"
                                      Visibility="{Binding IsToggleEditor, Converter={StaticResource BoolToVisibility}}" />

                        <!-- One of a list -->
                        <ComboBox MinWidth="120"
                                  FontSize="{Binding FontSize}"
                                  ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding SelectedChoice}"
                                  Visibility="{Binding IsChoiceEditor, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!--
                        Locked (F2): over the editors, a touch asks for a login
                        at the level the setting needs.
                    -->
                    <Button Grid.Row="{Binding EditorRow}"
                            Grid.Column="{Binding EditorColumn}"
                            Grid.ColumnSpan="{Binding EditorColumnSpan}"
                            Command="{Binding UnlockCommand}"
                            ToolTip="{Binding LockHint}"
                            Cursor="Hand"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#01000000">
                                    <TextBlock Text="&#x1F512;"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="14"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,2,0"
                                               Foreground="{StaticResource Text.Secondary}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter TargetName="Caption" Property="Text" Value="{Binding Problem}" />
                    <Setter TargetName="Caption" Property="Foreground" Value="#F8C4C4" />
                    <Setter TargetName="Caption" Property="FontSize" Value="12" />
                    <Setter TargetName="Caption" Property="TextWrapping" Value="Wrap" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#DB5C5C" />
                    <Setter TargetName="Box" Property="ToolTip" Value="{Binding Problem}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A button -->
        <DataTemplate DataType="{x:Type screens:ButtonWidgetViewModel}">
            <Button Content="{Binding Caption}"
                    Command="{Binding Command}"
                    FontSize="{Binding FontSize}" />
        </DataTemplate>
        <!-- A screen's widgets, each where it was put: the page's, and a popup's. -->
        <Style x:Key="ScreenCanvas" TargetType="ItemsControl">
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Width" Value="{Binding Width}" />
                        <Setter Property="Height" Value="{Binding Height}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The page on view, and a popup over it: the page dimmed behind and
            still running, but taking no input until the popup is closed. Both
            in one scale, so a popup's text is the size of the page's.
        -->
        <Viewbox Stretch="Uniform" Margin="4">
            <Grid x:Name="Stage" Width="{Binding Page.Width}" Height="{Binding Page.Height}">
                <ItemsControl x:Name="Canvas"
                              Style="{StaticResource ScreenCanvas}"
                              ItemsSource="{Binding Page.Widgets}"
                              IsEnabled="{Binding IsPageEnabled}" />

                <Grid x:Name="PopupLayer" Visibility="{Binding HasPopup, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Fill="#A6000000" />

                    <Border x:Name="PopupFrame"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource Surface.Canvas}"
                            BorderBrush="{StaticResource Surface.Border}"
                            BorderThickness="1"
                            DataContext="{Binding Popup}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                        </Border.Effect>
                        <Grid>
                            <ItemsControl Style="{StaticResource ScreenCanvas}" ItemsSource="{Binding Widgets}" />
                            <!-- A popup with no Close button of its own gets this one. -->
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Width="40"
                                    Height="40"
                                    FontSize="20"
                                    Content="✕"
                                    ToolTip="Close"
                                    Command="{Binding DataContext.ClosePopupCommand, ElementName=Stage}"
                                    Visibility="{Binding NeedsCloseCorner, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>

        <!--
            The login popup (F2): over the page, the popup and the status
            line alike. Who, from the project's users; the PIN on a keypad
            - or the keyboard - as dots; what asked for it, and why not.
        -->
        <Grid x:Name="LoginLayer"
              Grid.RowSpan="2"
              Panel.ZIndex="10"
              Visibility="{Binding HasLogin, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#B3000000" />
            <Border DataContext="{Binding Login}"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    CornerRadius="6"
                    Background="{StaticResource Surface.Canvas}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Log In" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                    <TextBlock Text="{Binding Prompt}" Margin="0,4,0,12" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" />

                    <ItemsControl x:Name="LoginNames" ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource TextToggleButton}"
                                              MinWidth="120"
                                              Height="40"
                                              Margin="0,0,6,6"
                                              FontSize="15"
                                              Command="{Binding DataContext.ChooseCommand, ElementName=LoginNames}"
                                              CommandParameter="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,8,0,8"
                            Height="44"
                            CornerRadius="3"
                            Background="{StaticResource Surface.Panel}"
                            BorderBrush="{StaticResource Surface.Border}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding PinDots}"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Primary}" />
                    </Border>

                    <UniformGrid Columns="3" Rows="4">
                        <UniformGrid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Height" Value="54" />
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="FontSize" Value="22" />
                            </Style>
                        </UniformGrid.Resources>
                        <Button Content="1" Command="{Binding DigitCommand}" CommandParameter="1" />
                        <Button Content="2" Command="{Binding DigitCommand}" CommandParameter="2" />
                        <Button Content="3" Command="{Binding DigitCommand}" CommandParameter="3" />
                        <Button Content="4" Command="{Binding DigitCommand}" CommandParameter="4" />
                        <Button Content="5" Command="{Binding DigitCommand}" CommandParameter="5" />
                        <Button Content="6" Command="{Binding DigitCommand}" CommandParameter="6" />
                        <Button Content="7" Command="{Binding DigitCommand}" CommandParameter="7" />
                        <Button Content="8" Command="{Binding DigitCommand}" CommandParameter="8" />
                        <Button Content="9" Command="{Binding DigitCommand}" CommandParameter="9" />
                        <Button Content="⌫" ToolTip="Delete the last digit" Command="{Binding BackCommand}" />
                        <Button Content="0" Command="{Binding DigitCommand}" CommandParameter="0" />
                        <Button Content="✓" ToolTip="Log in" Command="{Binding LogInCommand}" />
                    </UniformGrid>

                    <TextBlock Text="{Binding Problem}"
                               Margin="0,8,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="#F8C4C4"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />

                    <DockPanel Margin="0,12,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="Log In" MinWidth="100" Height="36" Margin="6,0,0,0" Command="{Binding LogInCommand}" />
                        <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="100" Height="36" Command="{Binding CancelCommand}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Exit"
                        MinWidth="80"
                        ToolTip="Stop every station and close"
                        Click="OnExitClick" />
                <!-- Who is logged in (F2), and Log In or Out; only with users in the project. -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Margin="12,0,0,0"
                            Visibility="{Binding Session.IsEnforced, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="UserStatus"
                               Text="{Binding Session.StatusText}"
                               Margin="0,0,8,0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Primary}" />
                    <Button Content="{Binding Session.ActionText}"
                            MinWidth="80"
                            Command="{Binding LogInOutCommand}" />
                </StackPanel>
                <!-- The PLCs: connected or not, passes run, what last went wrong. -->
                <TextBlock x:Name="ControllerStatus"
                           DockPanel.Dock="Right"
                           Margin="12,0"
                           MaxWidth="700"
                           Foreground="{StaticResource Text.Secondary}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProblemText}"
                           Foreground="#D9A33A"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ProblemText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
