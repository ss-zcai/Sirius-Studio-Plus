<Window x:Class="Sirius.Studio.App.Screens.RuntimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:screens="clr-namespace:Sirius.Studio.App.Screens"
        xmlns:controls="clr-namespace:Sirius.Studio.App.Controls"
        Title="Sirius Edge"
        Width="1296"
        Height="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Canvas}"
        Closing="OnClosing"
        KeyDown="OnKeyDown">

    <!--
        A project's screen, running. The screen is laid out on a canvas of its
        own size and scaled as a whole to the window, so it looks the same on
        any display. Along the bottom: anything the screen or a station could
        not find, and the way out.
    -->
    <Window.Resources>
        <!-- Fixed text -->
        <DataTemplate DataType="{x:Type screens:TextWidgetViewModel}">
            <TextBlock Text="{Binding Text}"
                       FontSize="{Binding FontSize}"
                       Foreground="{StaticResource Text.Primary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- Logo -->
        <DataTemplate DataType="{x:Type screens:LogoWidgetViewModel}">
            <Grid>
                <Image Source="{Binding Picture}" Stretch="Uniform" />
                <TextBlock Text="{Binding Missing}"
                           Foreground="#DB5C5C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- A station's picture -->
        <DataTemplate DataType="{x:Type screens:ImageWidgetViewModel}">
            <Border BorderBrush="{StaticResource Surface.Border}" BorderThickness="1">
                <controls:ImageViewer IsDisplayOnly="True"
                                      Background="{Binding Background}"
                                      ImageSource="{Binding Picture}"
                                      Shapes="{Binding Shapes}" />
            </Border>
        </DataTemplate>

        <!-- PASS / FAIL -->
        <DataTemplate DataType="{x:Type screens:VerdictWidgetViewModel}">
            <Border x:Name="Box"
                    CornerRadius="4"
                    BorderThickness="2"
                    Background="{StaticResource Surface.Node}"
                    BorderBrush="{StaticResource Surface.Border}"
                    ToolTip="{Binding Detail}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Word"
                               Text="{Binding Text}"
                               FontSize="{Binding FontSize}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}" />
                    <TextBlock Text="{Binding Detail}"
                               FontSize="11"
                               Margin="6,0"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Secondary}"
                               Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Look}" Value="Pass">
                    <Setter TargetName="Box" Property="Background" Value="#1E3A24" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#6DBF4A" />
                    <Setter TargetName="Word" Property="Foreground" Value="#B7E8A0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Fail">
                    <Setter TargetName="Box" Property="Background" Value="#4A1E20" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#DB5C5C" />
                    <Setter TargetName="Word" Property="Foreground" Value="#F8C4C4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Look}" Value="Fault">
                    <Setter TargetName="Box" Property="Background" Value="#3E3420" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#D9A33A" />
                    <Setter TargetName="Word" Property="Foreground" Value="#F7EBD4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Counts -->
        <DataTemplate DataType="{x:Type screens:CounterWidgetViewModel}">
            <Border CornerRadius="4"
                    Background="{StaticResource Surface.Panel}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    Padding="8,4">
                <UniformGrid Columns="4" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Total}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Pass" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Passed}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="#B7E8A0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Fail" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Failed}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="#F8C4C4" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Yield" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Yield}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                    </StackPanel>
                </UniformGrid>
            </Border>
        </DataTemplate>

        <!-- A result -->
        <DataTemplate DataType="{x:Type screens:ValueWidgetViewModel}">
            <Border CornerRadius="3"
                    Background="{StaticResource Surface.Panel}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    Padding="8,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Value}"
                               FontSize="{Binding FontSize}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}" />
                    <TextBlock Text="{Binding Label}"
                               FontSize="{Binding FontSize}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Secondary}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- On / off, big enough for a finger -->
        <Style x:Key="SettingSwitch" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                CornerRadius="3"
                                Padding="10,2"
                                Background="{StaticResource Surface.Node}"
                                BorderBrush="{StaticResource Surface.Border}"
                                BorderThickness="1">
                            <TextBlock x:Name="Word"
                                       Text="Off"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Word" Property="Text" Value="On" />
                                <Setter TargetName="Word" Property="Foreground" Value="#B7E8A0" />
                                <Setter TargetName="Track" Property="Background" Value="#1E3A24" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6DBF4A" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Text.Secondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A setting: changed here within its limits, or only shown. The label
            beside the control or above it; the control the designer chose for
            a number - − box +, a slider, a box, or a range on one slider with
            two handles. A slider updates the setting when it is let go.
        -->
        <DataTemplate DataType="{x:Type screens:SettingWidgetViewModel}">
            <Border x:Name="Box"
                    CornerRadius="3"
                    Background="{StaticResource Surface.Panel}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    Padding="8,2"
                    ToolTip="{Binding Hint}">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding LabelWidth}" />
                        <ColumnDefinition Width="{Binding EditorWidth}" />
                    </Grid.ColumnDefinitions>

                    <!-- The label - or, after a refused change, why -->
                    <DockPanel Grid.Row="0"
                               Grid.Column="0"
                               Margin="{Binding LabelMargin}"
                               VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left"
                                Margin="0,0,6,0"
                                Padding="3,0"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{StaticResource Published.Background}"
                                BorderBrush="{StaticResource Published.Border}"
                                BorderThickness="1"
                                ToolTip="A setting">
                            <TextBlock Text="set" FontSize="9" Foreground="{StaticResource Published.Text}" />
                        </Border>
                        <TextBlock x:Name="Caption"
                                   Text="{Binding Label}"
                                   FontSize="{Binding FontSize}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Text.Secondary}" />
                    </DockPanel>

                    <Grid x:Name="Editors"
                          Grid.Row="{Binding EditorRow}"
                          Grid.Column="{Binding EditorColumn}"
                          Grid.ColumnSpan="{Binding EditorColumnSpan}"
                          HorizontalAlignment="{Binding EditorAlignment}"
                          VerticalAlignment="Center">

                        <!-- Only shown -->
                        <TextBlock Text="{Binding DisplayText}"
                                   FontSize="{Binding FontSize}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Primary}"
                                   Visibility="{Binding IsDisplayOnly, Converter={StaticResource BoolToVisibility}}" />

                        <!-- − box + -->
                        <DockPanel x:Name="Stepper" Visibility="{Binding IsStepperEditor, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Left"
                                    Content="−"
                                    MinWidth="32"
                                    FontSize="{Binding FontSize}"
                                    Padding="0"
                                    Command="{Binding LowerCommand}"
                                    ToolTip="Lower" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <Button DockPanel.Dock="Right"
                                    Content="+"
                                    MinWidth="32"
                                    FontSize="{Binding FontSize}"
                                    Padding="0"
                                    Command="{Binding RaiseCommand}"
                                    ToolTip="Raise" />
                            <TextBox Width="{Binding BoxWidth}"
                                     Margin="4,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                        </DockPanel>

                        <!-- A box alone -->
                        <DockPanel x:Name="BoxOnly" Visibility="{Binding IsBoxEditor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox MinWidth="90"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                        </DockPanel>

                        <!-- A slider, and the number it is at -->
                        <DockPanel x:Name="Slider" Visibility="{Binding IsSliderEditor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox DockPanel.Dock="Right"
                                     Width="80"
                                     Margin="8,0,0,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                            <controls:RangeSlider IsSingle="True"
                                                  MinWidth="80"
                                                  Height="28"
                                                  VerticalAlignment="Center"
                                                  Minimum="{Binding SliderMinimum}"
                                                  Maximum="{Binding SliderMaximum}"
                                                  Step="{Binding SliderStep}"
                                                  High="{Binding SliderValue, UpdateSourceTrigger=Explicit}"
                                                  ValueCommitted="OnSliderCommitted" />
                        </DockPanel>

                        <!-- A range: the low end's box, one slider with two handles, the high end's box -->
                        <DockPanel x:Name="Range" Visibility="{Binding IsRangeEditor, Converter={StaticResource BoolToVisibility}}">
                            <TextBox DockPanel.Dock="Left"
                                     Width="80"
                                     Margin="0,0,8,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     ToolTip="The low end"
                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox DockPanel.Dock="Right"
                                     Width="80"
                                     Margin="8,0,0,0"
                                     FontSize="{Binding FontSize}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     ToolTip="The high end"
                                     Text="{Binding HighValueText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnSettingBoxKeyDown" />
                            <controls:RangeSlider MinWidth="80"
                                                  Height="28"
                                                  VerticalAlignment="Center"
                                                  Minimum="{Binding SliderMinimum}"
                                                  Maximum="{Binding SliderMaximum}"
                                                  Step="{Binding SliderStep}"
                                                  Low="{Binding SliderValue, UpdateSourceTrigger=Explicit}"
                                                  High="{Binding HighSliderValue, UpdateSourceTrigger=Explicit}"
                                                  ValueCommitted="OnSliderCommitted" />
                        </DockPanel>

                        <!-- On or off -->
                        <ToggleButton HorizontalAlignment="Right"
                                      Style="{StaticResource SettingSwitch}"
                                      FontSize="{Binding FontSize}"
                                      IsChecked="{Binding IsOn}"
                                      Visibility="{Binding IsToggleEditor, Converter={StaticResource BoolToVisibility}}" />

                        <!-- One of a list -->
                        <ComboBox MinWidth="120"
                                  FontSize="{Binding FontSize}"
                                  ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding SelectedChoice}"
                                  Visibility="{Binding IsChoiceEditor, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter TargetName="Caption" Property="Text" Value="{Binding Problem}" />
                    <Setter TargetName="Caption" Property="Foreground" Value="#F8C4C4" />
                    <Setter TargetName="Caption" Property="FontSize" Value="12" />
                    <Setter TargetName="Caption" Property="TextWrapping" Value="Wrap" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#DB5C5C" />
                    <Setter TargetName="Box" Property="ToolTip" Value="{Binding Problem}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A button -->
        <DataTemplate DataType="{x:Type screens:ButtonWidgetViewModel}">
            <Button Content="{Binding Caption}"
                    Command="{Binding Command}"
                    FontSize="{Binding FontSize}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Viewbox Stretch="Uniform" Margin="4">
            <ItemsControl x:Name="Canvas"
                          ItemsSource="{Binding Widgets}"
                          Width="{Binding Width}"
                          Height="{Binding Height}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Width" Value="{Binding Width}" />
                        <Setter Property="Height" Value="{Binding Height}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Viewbox>

        <Border Grid.Row="1"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Exit"
                        MinWidth="80"
                        ToolTip="Stop every station and close"
                        Click="OnExitClick" />
                <TextBlock Text="{Binding ProblemText}"
                           Foreground="#D9A33A"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ProblemText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
