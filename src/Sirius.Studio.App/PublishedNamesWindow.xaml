<Window x:Class="Sirius.Studio.App.PublishedNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Published Names"
        Width="620"
        Height="380"
        MinWidth="420"
        MinHeight="220"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        Every name the recipe publishes for screens, with where it comes
        from. A name whose output or setting has gone is marked, to be
        renamed onto the right one or dropped.
    -->
    <Grid Margin="16,14,16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,0,0,10"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Screens find this recipe's results, settings and views by these names. Publish more by right-clicking a node on the canvas, or a setting's name in the properties panel." />

        <ListView x:Name="Items"
                  Grid.Row="1"
                  Background="{StaticResource Surface.Panel}"
                  BorderBrush="{StaticResource Surface.Border}"
                  Foreground="{StaticResource Text.Primary}"
                  ItemContainerStyle="{StaticResource DarkListViewItem}"
                  SelectionMode="Single"
                  MouseDoubleClick="OnRename"
                  SelectionChanged="OnSelectionChanged">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewHeader}">
                    <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Kind" Width="70" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="From" Width="230" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="" Width="90" DisplayMemberBinding="{Binding State}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Nothing is published yet." />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RenameButton" MinWidth="86" Content="_Rename..." Click="OnRename" />
                <Button x:Name="UnpublishButton" MinWidth="86" Margin="6,0,0,0" Content="_Unpublish" Click="OnUnpublish" />
            </StackPanel>
            <Button HorizontalAlignment="Right" MinWidth="86" Content="_Close" IsCancel="True" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
