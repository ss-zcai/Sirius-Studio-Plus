<Window x:Class="Sirius.Studio.App.LineSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Line Settings"
        Width="720"
        Height="380"
        MinWidth="480"
        MinHeight="220"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        A station's settings changed on the line, beside the recipe's own:
        taken into the recipe so the two agree again, or forgotten.
    -->
    <Grid Margin="16,14,16,14" TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,0,0,10"
                   Foreground="{StaticResource Text.Secondary}" />

        <ListView x:Name="Items"
                  Grid.Row="1"
                  Background="{StaticResource Surface.Panel}"
                  BorderBrush="{StaticResource Surface.Border}"
                  Foreground="{StaticResource Text.Primary}"
                  ItemContainerStyle="{StaticResource DarkListViewItem}"
                  SelectionMode="Extended"
                  SelectionChanged="OnSelectionChanged">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewHeader}">
                    <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="On the line" Width="90" DisplayMemberBinding="{Binding OnLine}" />
                    <GridViewColumn Header="In the recipe" Width="100" DisplayMemberBinding="{Binding InRecipe}" />
                    <GridViewColumn Header="From" Width="200" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="Changed" Width="130" DisplayMemberBinding="{Binding Changed}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Nothing has been changed on the line: the recipe runs as saved." />

        <TextBlock x:Name="ProblemText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#D9A33A"
                   Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="TakeButton"
                        MinWidth="120"
                        Content="_Take into Recipe"
                        ToolTip="Put the line's values into the recipe itself, and forget them on the line"
                        Click="OnTake" />
                <Button x:Name="ForgetButton"
                        MinWidth="86"
                        Margin="6,0,0,0"
                        Content="_Forget"
                        ToolTip="Go back to the recipe's own values from the next start"
                        Click="OnForget" />
            </StackPanel>
            <Button HorizontalAlignment="Right" MinWidth="86" Content="_Close" IsCancel="True" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
