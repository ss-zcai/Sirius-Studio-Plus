<Window x:Class="Sirius.Studio.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="400"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!-- Asks for one line of text, checked as it is typed. -->
    <StackPanel Margin="20,16,20,16" TextElement.Foreground="{StaticResource Text.Primary}">
        <TextBlock x:Name="PromptText"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,0,0,10" />

        <TextBox x:Name="AnswerBox" TextChanged="OnAnswerChanged" />

        <TextBlock x:Name="ProblemText"
                   Margin="0,6,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#DB5C5C"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton"
                    MinWidth="86"
                    Content="_OK"
                    IsDefault="True"
                    Click="OnOk" />
            <Button MinWidth="86"
                    Margin="6,0,0,0"
                    Content="_Cancel"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
