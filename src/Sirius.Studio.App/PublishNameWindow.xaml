<Window x:Class="Sirius.Studio.App.PublishNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <!--
        Gives an output, a setting or a viewer the name a screen finds it by.
        The name is checked as it is typed, so a clash is seen before OK
        rather than refused after it.
    -->
    <StackPanel Margin="20,16,20,16" TextElement.Foreground="{StaticResource Text.Primary}">
        <TextBlock x:Name="WhatText"
                   TextWrapping="Wrap"
                   FontSize="13" />

        <TextBlock Text="Name"
                   Margin="0,14,0,4"
                   FontSize="11"
                   Foreground="{StaticResource Text.Secondary}" />
        <TextBox x:Name="NameBox"
                 TextChanged="OnNameChanged" />

        <TextBlock x:Name="ProblemText"
                   Margin="0,6,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#DB5C5C" />

        <!-- A number published as a setting: how far the line may take it -->
        <StackPanel x:Name="LimitsPanel" Visibility="Collapsed">
            <TextBlock Text="On the line, between (blank for the node's own limit)"
                       Margin="0,14,0,4"
                       FontSize="11"
                       Foreground="{StaticResource Text.Secondary}" />
            <UniformGrid Columns="2">
                <TextBox x:Name="LowestBox"
                         Margin="0,0,4,0"
                         ToolTip="The lowest it may be set to on the line"
                         TextChanged="OnLimitsChanged" />
                <TextBox x:Name="HighestBox"
                         ToolTip="The highest it may be set to on the line"
                         TextChanged="OnLimitsChanged" />
            </UniformGrid>
            <TextBlock x:Name="NodeRangeText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Text.Secondary}" />
        </StackPanel>

        <TextBlock x:Name="HintText"
                   Margin="0,6,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Screens find it by this name. If you replace the node later, give the new one the same name and the screens keep working." />

        <Grid Margin="0,18,0,0">
            <Button x:Name="UnpublishButton"
                    HorizontalAlignment="Left"
                    MinWidth="86"
                    Content="_Unpublish"
                    ToolTip="Take the name off; screens using it will report it missing."
                    Click="OnUnpublish" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        MinWidth="86"
                        Margin="6,0,0,0"
                        Content="_OK"
                        IsDefault="True"
                        Click="OnOk" />
                <Button MinWidth="86"
                        Margin="6,0,0,0"
                        Content="_Cancel"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
