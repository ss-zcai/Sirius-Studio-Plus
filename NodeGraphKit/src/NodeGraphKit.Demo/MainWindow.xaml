<Window x:Class="NodeGraphKit.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="clr-namespace:NodeGraphKit.Controls;assembly=NodeGraphKit"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        Title="{Binding Title}"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Activated="OnActivated"
        Closing="OnClosing"
        Background="{StaticResource Surface.Background}">

    <!--
        The canvas handles the edit shortcuts itself while it has the focus.
        These cover the rest of the window - Ctrl+Z with the toolbox focused
        still undoes - and a focused TextBox still takes its own first.
    -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="OnEditCommand" CanExecute="OnEditCommandCanExecute" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="OnEditCommand" CanExecute="OnEditCommandCanExecute" />
        <CommandBinding Command="ApplicationCommands.Cut" Executed="OnEditCommand" CanExecute="OnEditCommandCanExecute" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnEditCommand" CanExecute="OnEditCommandCanExecute" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="OnEditCommand" CanExecute="OnEditCommandCanExecute" />
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="OnEditCommand" CanExecute="OnEditCommandCanExecute" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindCommand" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="ApplicationCommands.Redo" />
    </Window.InputBindings>

    <!-- Text colour inherited, not forced by a TextBlock style: that would also repaint popups. -->
    <Grid TextElement.Foreground="{StaticResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Panel}">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_new}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_open}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_save}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_save_as}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="E_xit" Click="OnExitClick" />
                </MenuItem>

                <MenuItem Header="_Edit">
                    <!-- The headers name the step: "Undo Move", not "Undo". -->
                    <MenuItem Header="{Binding Editor.UndoText}" InputGestureText="Ctrl+Z" Command="{Binding Editor.UndoCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_undo}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding Editor.RedoText}" InputGestureText="Ctrl+Y" Command="{Binding Editor.RedoCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_redo}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding Editor.CutCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_cut}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding Editor.CopyCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_copy}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding Editor.PasteCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_paste}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="D_uplicate" InputGestureText="Ctrl+D" Command="{Binding Editor.DuplicateCommand}" />
                    <Separator />
                    <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding Editor.SelectAllCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_select_all}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Delete Selection" InputGestureText="Del" Command="{Binding Editor.DeleteSelectionCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_delete}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />

                    <!--
                        A HeaderTemplate draws the swatch rather than the
                        Icon slot: a Setter.Value holding an element hands
                        every item the same element, and only the last would
                        show it.
                    -->
                    <MenuItem Header="Node _Style" ItemsSource="{Binding AccentOptions}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Command" Value="{Binding DataContext.Editor.SetAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="CommandParameter" Value="{Binding Accent}" />
                                <Setter Property="HeaderTemplate" Value="{StaticResource AccentItemTemplate}" />
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_View">
                    <MenuItem Header="_Toolbox" Tag="toolbox" Click="OnShowPanelClick" />
                    <MenuItem Header="_Properties" Tag="properties" Click="OnShowPanelClick" />
                    <Separator />
                    <MenuItem Header="Zoom _In" Click="OnZoomInClick">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_zoom_in}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Zoom _Out" Click="OnZoomOutClick">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_zoom_out}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Fit to Screen" Click="OnFitClick">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_zoom_fit}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_Run">
                    <MenuItem Header="_Run Graph" InputGestureText="F5" Command="{Binding RunCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Icon.ph_run}" Width="14" Height="14" /></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_Help">
                    <MenuItem Header="_About…" Click="OnAboutClick" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Toolbar: a plain panel rather than a ToolBar, whose chrome would need unpicking. -->
        <Border Grid.Row="1"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" ToolTip="New (Ctrl+N)" Command="{Binding NewCommand}">
                    <Image Source="{StaticResource Icon.ph_new}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Open (Ctrl+O)" Command="{Binding OpenCommand}">
                    <Image Source="{StaticResource Icon.ph_open}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Save (Ctrl+S)" Command="{Binding SaveCommand}">
                    <Image Source="{StaticResource Icon.ph_save}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Save as…" Command="{Binding SaveAsCommand}">
                    <Image Source="{StaticResource Icon.ph_save_as}" Width="18" Height="18" />
                </Button>

                <Separator />

                <Button Style="{StaticResource ToolbarButton}" ToolTip="{Binding Editor.UndoText}" Command="{Binding Editor.UndoCommand}">
                    <Image Source="{StaticResource Icon.ph_undo}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="{Binding Editor.RedoText}" Command="{Binding Editor.RedoCommand}">
                    <Image Source="{StaticResource Icon.ph_redo}" Width="18" Height="18" />
                </Button>

                <Separator />

                <Button Style="{StaticResource ToolbarButton}" ToolTip="Cut the selected nodes (Ctrl+X)" Command="{Binding Editor.CutCommand}">
                    <Image Source="{StaticResource Icon.ph_cut}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Copy the selected nodes (Ctrl+C)" Command="{Binding Editor.CopyCommand}">
                    <Image Source="{StaticResource Icon.ph_copy}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Paste nodes (Ctrl+V)" Command="{Binding Editor.PasteCommand}">
                    <Image Source="{StaticResource Icon.ph_paste}" Width="18" Height="18" />
                </Button>

                <Separator />

                <!-- The styler: a swatch and a name, showing what the selection is. -->
                <Image Source="{StaticResource Icon.ph_style}"
                       Width="18"
                       Height="18"
                       Margin="4,0,2,0"
                       VerticalAlignment="Center"
                       Opacity="{Binding Editor.HasNodeSelection, Converter={StaticResource EnabledToOpacity}}" />
                <ComboBox Width="110"
                          Margin="2,0"
                          VerticalAlignment="Center"
                          ToolTip="Colour the selected nodes"
                          IsEnabled="{Binding Editor.HasNodeSelection}"
                          ItemsSource="{Binding AccentOptions}"
                          SelectedItem="{Binding SelectedAccentOption, Mode=TwoWay}"
                          ItemTemplate="{StaticResource AccentItemTemplate}" />

                <Separator />

                <Button Style="{StaticResource ToolbarButton}" ToolTip="Run the graph (F5)" Command="{Binding RunCommand}">
                    <Image Source="{StaticResource Icon.ph_run}" Width="18" Height="18" />
                </Button>

                <Separator />

                <Button Style="{StaticResource ToolbarButton}" ToolTip="Zoom in" Click="OnZoomInClick">
                    <Image Source="{StaticResource Icon.ph_zoom_in}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Zoom out" Click="OnZoomOutClick">
                    <Image Source="{StaticResource Icon.ph_zoom_out}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Fit the graph to the window" Click="OnFitClick">
                    <Image Source="{StaticResource Icon.ph_zoom_fit}" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Border>

        <!--
            The three views get their DataContext in code rather than by
            binding: a docked panel inherits the window's DataContext only
            once it is hosted, and should not depend on when that happens.

            IDE-style docking: every panel can be dragged to another edge,
            tabbed, floated or closed and re-opened from the View menu. The
            graph is a document, so it holds the centre and cannot be hidden.
        -->
        <avalonDock:DockingManager x:Name="Docking"
                                   Grid.Row="2"
                                   AllowMixedOrientation="True"
                                   Background="{StaticResource Surface.Background}">
            <avalonDock:DockingManager.Theme>
                <themes:Vs2013DarkTheme />
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePane DockWidth="230">
                        <avalonDock:LayoutAnchorable Title="Toolbox" ContentId="toolbox" CanClose="False">
                            <kit:ToolboxView x:Name="Toolbox" />
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                    <avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocument Title="Graph" ContentId="graph" CanClose="False">
                            <kit:GraphEditorView x:Name="Graph" />
                        </avalonDock:LayoutDocument>
                    </avalonDock:LayoutDocumentPane>

                    <avalonDock:LayoutAnchorablePane DockWidth="300">
                        <avalonDock:LayoutAnchorable Title="Properties" ContentId="properties" CanClose="False">
                            <kit:PropertiesView x:Name="Properties" />
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Text.Secondary}" />
        </Border>
    </Grid>
</Window>
