<UserControl x:Class="NodeGraphKit.Controls.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NodeGraphKit.ViewModels">

    <!--
        The properties panel. DataContext: a GraphEditorViewModel; it shows
        the selected node's name, Enabled, parameters and status.

        HeaderContent and FooterContent take the host's own controls, placed
        above the parameters and below the status.
    -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="PROPERTIES" Style="{StaticResource SectionHeader}" />

        <TextBlock DockPanel.Dock="Top"
                   Text="Select a node on the canvas to edit its properties."
                   Foreground="{StaticResource Text.Secondary}"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="8,0,8,8"
                   Visibility="{Binding SelectedNode, Converter={StaticResource VisibleWhenNull}}" />

        <!-- Collapsed with nothing selected, rather than a page of controls that do nothing. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}}">
            <StackPanel Margin="8,0,8,8" DataContext="{Binding SelectedNode}">
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,2"
                         ToolTip="Rename this node" />
                <TextBlock Text="{Binding TypeName}" Foreground="{StaticResource Text.Secondary}" FontSize="10" Margin="0,0,0,8" />

                <!-- Bypass. Lives here rather than on the node; the canvas dims a bypassed node. -->
                <CheckBox Content="Enabled"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          ToolTip="Clear to bypass this node"
                          Margin="0,0,0,12" />

                <ContentPresenter Content="{Binding HeaderContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ParameterViewModel}">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           ToolTip="{Binding Description}" />

                                <!-- A number with a declared minimum and maximum. -->
                                <Grid Visibility="{Binding IsSlider, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="{Binding Minimum}"
                                            Maximum="{Binding Maximum}"
                                            TickFrequency="{Binding Step}"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding NumericValue, Mode=TwoWay}"
                                            VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NumericText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Margin="4,0,0,0" />
                                </Grid>

                                <TextBox Text="{Binding NumericText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Visibility="{Binding IsNumberBox, Converter={StaticResource BoolToVisibility}}" />

                                <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />

                                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                          Visibility="{Binding IsCheckBox, Converter={StaticResource BoolToVisibility}}" />

                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                          Visibility="{Binding IsComboBox, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="This node has no parameters."
                           Foreground="{StaticResource Text.Secondary}"
                           FontStyle="Italic"
                           Visibility="{Binding HasParameters, Converter={StaticResource InverseBoolToVisibility}}" />

                <!--
                    Status lives here rather than on the node, so the canvas
                    stays readable and a long message has room to wrap. The
                    node keeps only its coloured dot.
                -->
                <Border Margin="0,16,0,0"
                        Padding="8"
                        CornerRadius="3"
                        Background="#1A1B1E"
                        BorderBrush="{StaticResource Surface.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="STATUS"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#F59E0B"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border>

                <ContentPresenter Content="{Binding FooterContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
