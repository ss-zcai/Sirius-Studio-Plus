<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The node graph editor as a reusable library: graph model, undo, JSON
    files, view models, the dark theme and the three views (canvas,
    toolbox, properties). No algorithm and no evaluation - what a node
    does is the host application's business.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NodeGraphKit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nodify" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NodeGraphKit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
