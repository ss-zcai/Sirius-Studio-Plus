<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0-windows + WPF so the app's view-models can be tested. The product
      is Windows-only regardless (WPF shell, win-x64 OpenCV natives), and the
      view-models under test instantiate no UI elements, so no STA thread or
      dispatcher is required.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sirius.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sirius.Core\Sirius.Core.csproj" />
    <ProjectReference Include="..\..\src\Sirius.Vision\Sirius.Vision.csproj" />
    <ProjectReference Include="..\..\src\Sirius.Studio.App\Sirius.Studio.App.csproj" />
    <ProjectReference Include="..\..\src\Sirius.Builder\Sirius.Builder.csproj" />
    <ProjectReference Include="..\..\src\Sirius.Runner\Sirius.Runner.csproj" />

    <!--
      The sample custom node library: its nodes are exercised directly, and
      its built DLL is copied somewhere of its own and loaded the way the
      application loads one.
    -->
    <ProjectReference Include="..\..\samples\SampleNodes\SampleNodes.csproj" />
  </ItemGroup>

  <!-- The sample Python library, run through the application when numpy and OpenCV are there. -->
  <ItemGroup>
    <None Include="../../samples/PythonNodes/dark_spots.py"
          Link="python-samples/dark_spots.py"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    C++ node libraries, as source: built by the tests with the Visual C++
    compiler where there is one, against the headers the application ships
    in its cpp folder.
  -->
  <ItemGroup>
    <None Update="Native/**"
          Link="cpp-tests/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/CppNodes/sample_nodes.cpp"
          Link="cpp-tests/Native/sample_nodes.cpp"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
