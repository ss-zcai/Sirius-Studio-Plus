<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0-windows + WPF so the app's view-models can be tested. The product
      is Windows-only regardless (WPF shell, win-x64 OpenCV natives), and the
      view-models under test instantiate no UI elements, so no STA thread or
      dispatcher is required.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sirius.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Sirius.Core\Sirius.Core.csproj" />
    <ProjectReference Include="..\..\src\Core\Sirius.Vision\Sirius.Vision.csproj" />
    <ProjectReference Include="..\..\src\Shared\Sirius.UI\Sirius.UI.csproj" />
    <ProjectReference Include="..\..\src\Apps\Sirius.Studio\Sirius.Studio.csproj" />
    <ProjectReference Include="..\..\src\Apps\Sirius.Builder\Sirius.Builder.csproj" />
    <ProjectReference Include="..\..\src\Apps\Sirius.IV\Sirius.IV.csproj" />
    <ProjectReference Include="..\..\src\Apps\Sirius.Runner\Sirius.Runner.csproj" />
    <ProjectReference Include="..\..\src\Core\Sirius.Plc\Sirius.Plc.csproj" />

    <!-- A driver library, built but not referenced: the loader finds it in a folder, as plc-drivers\ holds one. -->
    <ProjectReference Include="..\TestPlcDriver\TestPlcDriver.csproj" ReferenceOutputAssembly="false" />

    <!--
      The sample custom node library: its nodes are exercised directly, and
      its built DLL is copied somewhere of its own and loaded the way the
      application loads one.
    -->
    <ProjectReference Include="..\..\samples\SampleNodes\SampleNodes.csproj" />

    <!-- The several-shots sample project's maker: what it writes is run end to end. -->
    <ProjectReference Include="..\..\tools\ShotSample\ShotSample.csproj" />

    <!-- The licence maker's window: its model and window, with a test key. -->
    <ProjectReference Include="..\..\tools\LicenceMakerApp\LicenceMakerApp.csproj" />
  </ItemGroup>

  <!-- The sample Python library, run through the application when numpy and OpenCV are there. -->
  <ItemGroup>
    <None Include="../../samples/PythonNodes/dark_spots.py"
          Link="python-samples/dark_spots.py"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    C++ node libraries, as source: built by the tests with the Visual C++
    compiler where there is one, against the headers the application ships
    in its cpp folder.
  -->
  <ItemGroup>
    <None Update="Native/**"
          Link="cpp-tests/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/CppNodes/sample_nodes.cpp"
          Link="cpp-tests/Native/sample_nodes.cpp"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyTestPlcDriver" AfterTargets="Build">
    <!--
      Built here, not only asked where it would be: the solution builds it
      for x64, into bin\x64\, so a fresh clone had nothing at the path asked
      for - only a folder that had once built it alone did.
    -->
    <MSBuild Projects="..\TestPlcDriver\TestPlcDriver.csproj" Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="TestPlcDriverAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(TestPlcDriverAssembly)" DestinationFolder="$(OutDir)plc-drivers-test\TestPlcDriver" SkipUnchangedFiles="true" />
  </Target>

</Project>
